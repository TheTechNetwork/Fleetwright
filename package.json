{
  "name": "agent-fleet",
  "version": "0.1.1",
  "description": "Self-hosted Claude Code session manager, and the multi-host control plane around it — sandboxes, scheduling, and a phone that can reach any of it.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "agent-hub": "./bin/agent-hub",
    "agent-fleet-sidecar": "./bin/agent-fleet-sidecar"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.js",
    "sidecar": "node bin/agent-fleet-sidecar",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "jose": "^6.2.9"
  }
}
