<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Android 13+ requires this to be granted at runtime before a notification
       can be shown at all. Asked for on first launch, because a fleet app that
       cannot notify you is missing the point of carrying it. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application
      android:label="Fleetwright"
      android:icon="@mipmap/ic_launcher"
      android:supportsRtl="true"
      android:networkSecurityConfig="@xml/network_security_config"
      android:theme="@style/Theme.Fleetwright">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:label="Fleetwright">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <!--
        COMING BACK FROM A PROVIDER. The coordinator's OAuth callback redirects
        to fleetwright://connected once it has stored the token, so the browser
        hands control back instead of leaving somebody on a page telling them
        to close a tab.

        singleTask so returning resumes the app that started the flow rather
        than stacking a second copy of it on top.

        NOT an App Link: those need a domain association file and a verified
        apex, which is real setup for anybody self-hosting this. A custom
        scheme is unverified — any app may claim it — which is exactly why the
        redirect carries only `provider` and `ok`, and no credential ever
        travels this way.
      -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="fleetwright" android:host="connected" />
      </intent-filter>
    </activity>

    <!--
      Registered so FCM can hand over a rotated token. Without it the app finds
      out about a new token only on the next launch, and until then the
      coordinator is sending to a token nothing will deliver.
    -->
    <service
        android:name=".Messaging"
        android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
