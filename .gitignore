node_modules/
*.log
.DS_Store
.wrangler/
dist/

# Android
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/android/app/google-services.json

# iOS — generated from project.yml by xcodegen
apps/ios/*.xcodeproj/
apps/ios/build/
# XcodeGen writes both of these on every `xcodegen generate` — "Plists are
# created on disk on every generation of the project". Committing one means
# editing a file whose contents are discarded before they are ever compiled.
# The source of truth for both is project.yml.
apps/ios/Fleetwright/Info.plist
apps/ios/Fleetwright/Fleetwright.entitlements

# A signing key must never be committed — but the reason it is ignored rather
# than merely not-added is /update: it refuses to pull into a dirty tree, and
# `git status --porcelain` counts untracked files. A stray release.jks in
# /opt/agent-fleet would silently stop that host updating.
*.jks

# IDE state, not project configuration. Android Studio rewrites .idea on
# almost every interaction and bakes in absolute local paths — the committed
# workspace.xml pinned an AVD at /Users/<someone>/.android/avd — so it
# conflicts on contact and is worthless on any other machine.
.idea/
*.iml
.DS_Store
