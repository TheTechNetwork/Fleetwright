# agent-fleet coordinator configuration.
#
# Only needed on the box (or the Worker) the fleet meets at. A single-machine
# test runs the coordinator, the sidecar and the session manager side by side on
# loopback, which is exactly what the defaults below do.

# --- where it listens --------------------------------------------------------
# Hosts dial ws://<bind>:<port>/host/connect and hold it open; clients POST to
# /api/intent on the same port. One origin, because a host pins exactly one.
#
# Loopback by default. Binding wider REQUIRES the admin token below — the
# process refuses to start otherwise, for the same reason agent-hub does: a control
# surface reachable off-box with no credential is remote control of every host
# in the fleet for anyone who can route to the port.
#
# To publish it, prefer keeping this on 127.0.0.1 and putting a tunnel in front.
AGENT_FLEET_COORDINATOR_BIND=127.0.0.1
AGENT_FLEET_COORDINATOR_PORT=8791

# --- credentials -------------------------------------------------------------
# HOSTS DO NOT HAVE A TOKEN. There is nothing to put here for them, and that is
# the point: each box keeps a private key, presents the public half once with a
# six-digit pin, and signs a fresh nonce on every connection. Nothing reusable
# crosses the wire, two hosts are distinguishable, and one can be revoked
# without touching the others.
#
# Mint a pin from the app, or with the admin token below:
#   curl -sX POST -H "authorization: Bearer $AGENT_FLEET_API_TOKEN" \
#        -d '{"kind":"host"}' https://<coordinator>/api/enroll
# then on the box:  sudo -u <service user> agent-fleet-sidecar enrol 123456

# The break-glass admin credential. Phones do NOT use this — they sign in and
# are issued their own per-device credential — and neither do hosts. It exists
# to mint the first enrolment pin and to get back in when nothing else works.
#
# Generate one with: openssl rand -hex 24
#
# Treat it as the fleet's root password: it can stop every session and revoke
# every host. Never bake it into an app binary; it is public the moment someone
# pulls the IPA.
AGENT_FLEET_API_TOKEN=

# --- what the coordinator remembers ------------------------------------------
# Which hosts are enrolled and their public keys, which devices have been issued
# credentials, and any outstanding enrolment pins. THIS LIST IS THE FLEET: the
# host registry is a cache rebuilt from what hosts report, but membership is not
# — lose this and every box is refused until somebody re-enrols it by hand.
#
# Created 0700 by the unit's StateDirectory=. The process refuses to start if it
# cannot write here, rather than working perfectly until the first restart.
AGENT_FLEET_COORDINATOR_STATE=/var/lib/agent-fleet-coordinator/state.json

# --- logging -----------------------------------------------------------------
# debug | info | warn | error
AGENT_FLEET_LOG_LEVEL=info
