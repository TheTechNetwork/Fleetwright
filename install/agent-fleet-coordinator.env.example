# agent-fleet coordinator configuration.
#
# Only needed on the box (or the Worker) the fleet meets at. A single-machine
# test runs the coordinator, the sidecar and the session manager side by side on
# loopback, which is exactly what the defaults below do.

# --- where it listens --------------------------------------------------------
# Hosts dial ws://<bind>:<port>/host/connect and hold it open; clients POST to
# /api/intent on the same port. One origin, because a host pins exactly one.
#
# Loopback by default. Binding wider REQUIRES both tokens below — the process
# refuses to start otherwise, for the same reason agent-hub does: a control
# surface reachable off-box with no credential is remote control of every host
# in the fleet for anyone who can route to the port.
#
# To publish it, prefer keeping this on 127.0.0.1 and putting a tunnel in front.
AGENT_FLEET_COORDINATOR_BIND=127.0.0.1
AGENT_FLEET_COORDINATOR_PORT=8791

# --- credentials -------------------------------------------------------------
# What a host presents to connect. Long-lived, one per box, 0600 on disk, and
# the same value goes in AGENT_FLEET_HOST_TOKEN in each host's
# /etc/agent-fleet-sidecar.env.
#
# Generate one with: openssl rand -hex 24
#
# §5 wants this replaced by a short-lived JWT signed per connection, so the
# durable secret never crosses the wire and replay is bounded — and by an
# enrollment flow that mints a per-host key rather than sharing one. This is the
# bearer-token step before that, and a shared token means revoking one host
# means rotating all of them.
AGENT_FLEET_HOST_TOKEN=

# What a client — a phone, a Shortcut, curl — presents to POST an intent.
# Distinct from the host token on purpose: they are different trust classes and
# revoking one must not disturb the other.
#
# §5 again: never bake this into an app binary, it is public the moment someone
# pulls the IPA. Mint per device at enrollment and store it in the iOS Keychain
# or Android Keystore, so a lost phone is one revocation rather than a
# fleet-wide rotation.
AGENT_FLEET_API_TOKEN=

# --- logging -----------------------------------------------------------------
# debug | info | warn | error
AGENT_FLEET_LOG_LEVEL=info
