#!/bin/sh
# Move a git-checkout install onto the packaged layout. Root, no arguments.
#
#   sudo -n /usr/local/sbin/fleetwright-migrate
#
# WHY THIS FILE EXISTS AT ALL, rather than the work happening in agent-hub.
# Switching layouts means rewriting systemd units and reloading the daemon, and
# the service is unprivileged on purpose. Everything else about updating is
# already unprivileged — fetch, verify, unpack, swap a symlink — and stays that
# way; this is the one step that is not.
#
# WHY IT LIVES IN /usr/local/sbin AND NOT IN THE INSTALL TREE. install.sh does
# `chown -R "$RUN_USER" "$DIR"` so that /update can pull, which means the
# service user can WRITE every file in the checkout. A sudoers rule naming a
# script the service user can rewrite is not a narrow grant — it is root, with
# extra steps. So this is installed by root, outside anything the service can
# touch, and the sudoers rule names this path exactly.
#
# NO ARGUMENTS, for the same reason the apt rule spells out its whole command
# line: sudoers matches argv, and every argument is a widening. Everything this
# needs it reads from /etc/agent-hub.env, which is root-owned and 0600.
#
# WHAT THE SERVICE USER CAN INFLUENCE, stated plainly because a grant nobody
# has bounded is a grant nobody can review:
#
#   WHEN this runs — that is the whole feature.
#   WHICH CHANNEL, via <stateDir>/release-channel, which it owns. That chooses
#     between two paths under the operator's own manifest URL and nothing else.
#
#   NOT the URL, which comes from the root-owned env file.
#   NOT the payload, which is checked against the sha256 in that manifest.
#   NOT what runs as root afterwards: the units it writes run AS THE SERVICE
#     USER, exactly as they did before. Nothing here gives away a shell.
set -eu

# The box's configuration, and the only place this reads anything from. The
# override exists so the whole migration can be driven end to end by a test
# against temporary directories — the path this file takes on a real box is the
# one nothing ever ran until a machine ran it, five times, badly.
ENV_FILE="${FLEETWRIGHT_ENV_FILE:-/etc/agent-hub.env}"
say()  { printf '%s\n' "$*"; }
die()  { printf 'FAIL %s\n' "$*" >&2; exit 1; }

# BEING ROOT IS NOT THE REQUIREMENT; BEING ABLE TO WRITE IS — the same rule
# bootstrap.sh states, and for the same reason. This said "run as root" and
# meant "I am going to write /opt and /etc", which is true on a box and false
# when every path it touches has been pointed somewhere else.
#
# install.sh does its own check for the units, which is where root is genuinely
# needed. Refusing here on a privilege rather than on an ability made the whole
# path untestable, and untestable is how it got to a fifth attempt.
BASE="${AGENT_FLEET_BASE:-/opt/fleetwright}"
mkdir -p "$BASE" 2>/dev/null || true
[ -w "$BASE" ] || die "cannot write $BASE — this needs to be run as root, or with AGENT_FLEET_BASE somewhere you own"

# Read the env file the way systemd does, and take only what is needed. Sourcing
# it would execute whatever is in there, in a root shell.
env_get() { sed -n "s/^$1=//p" "$ENV_FILE" 2>/dev/null | tail -1 | sed 's/^"\(.*\)"$/\1/; s/^'"'"'\(.*\)'"'"'$/\1/'; }

MANIFEST_URL="$(env_get AGENT_HUB_RELEASE_MANIFEST)"
[ -n "$MANIFEST_URL" ] || die "AGENT_HUB_RELEASE_MANIFEST is not set in $ENV_FILE, so there is nothing to migrate to."

INSTALL_DIR="$(env_get AGENT_HUB_INSTALL_DIR)"
[ -n "$INSTALL_DIR" ] || INSTALL_DIR=/opt/agent-fleet
STATE_DIR="$(env_get AGENT_HUB_STATE_DIR)"
[ -n "$STATE_DIR" ] || STATE_DIR=/var/lib/agent-hub

# ALREADY DONE IS NOT A FAILURE, BUT A LEFTOVER IS NOT DONE.
#
# This asked two questions and both were the wrong one.
#
#   [ -L "$BASE/current" ]  says a previous run laid a release out. It says
#     NOTHING about what this box runs. The first real migration failed after
#     that step, so the second one found the symlink, announced "already on the
#     packaged layout — nothing to do", changed nothing, and left a box that had
#     been told it converted and had not.
#
#   [ -f "$INSTALL_DIR/lib/..." ]  reads AGENT_HUB_INSTALL_DIR out of the env
#     file, and NOTHING EVER WRITES IT — src/config.js has a default and the
#     installer never records one. So this is really a hardcoded /opt/agent-fleet
#     wearing a variable's clothes, and it stays false even after a successful
#     migration.
#
# THE UNIT IS THE ANSWER. What a box runs is what systemd starts, and that is
# one grep away. A unit already pointing into the release tree is a converted
# box; anything else is not, whatever directories happen to exist.
# EXECSTART, NOT THE WHOLE FILE. A unit mentions the tree in more than one
# place — WorkingDirectory, EnvironmentFile — so grepping the file asked "does
# this unit mention the release directory" when the question is "does it RUN
# from it". A box whose ExecStart had been pointed back at a checkout, with a
# WorkingDirectory still naming the release, was told it was already converted
# and left exactly as it was.
#
# What a box runs is one line, and that is the line to read.
# THE SAME SEAM THE ENV FILE HAS, AND FOR THE SAME REASON. Every "converted
# box" path in this file was untestable while this was a literal: a test cannot
# write /etc/systemd/system without changing the machine it runs on, so the one
# case that matters most — a converted box that needs to be brought FORWARD —
# was asserted around rather than driven, and shipped broken.
#
# It widens nothing. sudoers resets the environment, so the service user cannot
# set this through the sudo rule; and even if it could, the only thing it
# decides is whether this box is treated as already converted. The payload is
# still checked against the manifest's sha256, the manifest URL still comes from
# the root-owned env file, and the units still run as the service user.
UNIT_DIR="${FLEETWRIGHT_UNIT_DIR:-/etc/systemd/system}"
UNIT="$UNIT_DIR/agent-hub.service"
CONVERTED=no
if [ -f "$UNIT" ] && grep '^ExecStart=' "$UNIT" | grep -q "$BASE/current"; then
  CONVERTED=yes
fi

# CONVERTED IS NOT THE SAME QUESTION AS UP TO DATE, and answering the first one
# deadlocked a box.
#
# This used to exit here: "already on the packaged layout — nothing to do". True,
# and not what anybody was asking. A converted box is one that HAS a release; it
# says nothing about WHICH, and the whole reason to re-run the installer is that
# the release a box is on may be broken.
#
# deb13-staging is the case that made this urgent. It runs v0.2.3, whose
# releaseLayout() refuses a packaged box's own path — so its own update path
# answers "there is no symlink to swap" and it cannot reach a version where that
# is fixed. Fixing main does not reach it: a box runs the RELEASE's code, not
# main's.
#
# The installer is the only way in, because it is the one component that does
# NOT come from the release — it comes from the checkout, refreshed by the
# one-liner, and is therefore always current. A box whose update path is broken
# can still be updated BY the installer, and refusing here was the one thing
# standing in the way.
#
# So the question moves below the manifest fetch, where the version is known,
# and becomes: is this box already on the release its channel points at?
if [ "$CONVERTED" = no ] && [ -L "$BASE/current" ]; then
  # A HALF-FINISHED MIGRATION IS A REASON TO CONTINUE, not to stop. Everything
  # below is idempotent: the version directory is removed and re-extracted, the
  # symlink is replaced atomically, and the installer is re-run.
  say "a previous attempt laid a release out and did not finish — continuing from there"
fi

# A CONVERTED BOX HAS NO CHECKOUT AND DOES NOT NEED ONE. This refusal is for a
# machine that is neither thing; asking it of a box that is already packaged
# would refuse every self-heal for want of a directory the migration deletes the
# need for.
if [ "$CONVERTED" = no ]; then
  [ -d "$INSTALL_DIR/.git" ] || die "$INSTALL_DIR is neither a checkout nor a release; this does not know what it is looking at."
fi

# The channel picks the address, exactly as src/core/release.js does it. Two
# paths under the operator's own URL — this cannot be pointed somewhere else.
CHANNEL="$(env_get AGENT_HUB_RELEASE_CHANNEL)"
[ -n "$CHANNEL" ] || CHANNEL="$(cat "$STATE_DIR/release-channel" 2>/dev/null || echo stable)"
case "$CHANNEL" in
  rolling|prerelease)
    MANIFEST_URL="$(printf '%s' "$MANIFEST_URL" | sed 's|/releases/latest/download/|/releases/download/rolling/|')" ;;
  *) ;;
esac

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT INT TERM

say "fetching $MANIFEST_URL"
curl -fsSL "$MANIFEST_URL" -o "$WORK/manifest.json" || die "could not fetch the release manifest"

json() { sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$WORK/manifest.json" | head -1; }
VERSION="$(json version)"
FILE="$(json file)"
SHA="$(json sha256)"
[ -n "$VERSION" ] && [ -n "$FILE" ] && [ -n "$SHA" ] || die "the manifest is missing version, file or sha256"

# A NAME, NEVER A PATH. Both of these become directory and file names below, and
# src/core/release.js refuses the same two shapes for the same reason: a version
# of ../../etc normalises straight out of where it is supposed to land.
for v in "$VERSION" "$FILE"; do
  case "$v" in
    */*|..*|.*|"") die "the manifest's version or filename is not a plain name: $v" ;;
  esac
done

# ALREADY ON IT IS THE ONLY "NOTHING TO DO", and it is knowable only here.
#
# Read from the release's own package.json rather than from anything this script
# remembers: what a box runs is what is on disk under the symlink, and every
# other source for that has been wrong at least once.
HEAL=no
if [ "$CONVERTED" = yes ]; then
  INSTALLED="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$BASE/current/package.json" 2>/dev/null | head -1)"
  if [ -n "$INSTALLED" ] && [ "$INSTALLED" = "$VERSION" ]; then
    # ALREADY ON IT IS NOT NOTHING TO DO, and this used to exit here.
    #
    # /update lays a release out unprivileged — fetch, verify, unpack, swap the
    # symlink — and restarts. Everything root owns stays as the LAST installer
    # left it: the units, the Claude hook, the sudoers rules, this helper. So a
    # box could be on the newest release and running an installer's output
    # from three releases ago, and the only remedy was a person with a shell
    # running --repair by hand. This is the one root step an update has, and
    # it is the step that makes installer changes ride the release.
    say "already on the packaged layout, running $VERSION — refreshing what the installer generates"
    HEAL=yes
  else
  # UNREADABLE IS NOT UP TO DATE. A `current` pointing at a directory with no
  # package.json is a box mid-way through something, and re-laying the release
  # is exactly the repair for it — so an empty INSTALLED falls through rather
  # than being compared to nothing and matching.
  say "on the packaged layout running ${INSTALLED:-a version that cannot be read}; ${CHANNEL:-stable} now has $VERSION"
  fi
fi

TARBALL_URL="$(printf '%s' "$MANIFEST_URL" | sed 's|/[^/]*$||')/$FILE"
say "fetching $TARBALL_URL"
curl -fsSL "$TARBALL_URL" -o "$WORK/$FILE" || die "could not download the release"

# VERIFIED BEFORE IT IS UNPACKED, not after. A tarball that is unpacked and then
# checked has already written whatever it contained.
GOT="$(sha256sum "$WORK/$FILE" | cut -d' ' -f1)"
[ "$GOT" = "$SHA" ] || die "the release does not match its manifest: expected $SHA, got $GOT"
say "sha256 ok"

# UNPACKED ONCE, WHERE ONLY ROOT CAN REACH, and every installer this helper
# runs as root runs from here. $BASE/releases is writable by the service user
# — applyRelease unpacks there — so an installer under it is a script the
# service user could have rewritten between the unpack and the exec, and the
# same goes for anything under `current`. $WORK is root's own temp directory.
mkdir -p "$WORK/release"
tar -xzf "$WORK/$FILE" -C "$WORK/release" --strip-components=1

# DOES THE THING WE ARE ABOUT TO RUN ACTUALLY START?
#
# The sha256 above proves the tarball is the one the manifest names. It says
# nothing about whether what is inside it runs, and both routes below end by
# running the installer out of this release — so a release carrying a broken
# installer strands the box, and cannot be fixed by fixing main. That is not
# hypothetical: v0.2.2 shipped an install.sh that died on `CHECK_ONLY: unbound
# variable`, and two attempts on a real machine got as far as moving `current`
# before finding out.
#
# `--help` is the cheap whole-file answer: it needs no node, no tmux and no
# root, and it is parsed inside the argument loop — so anything that runs before
# that loop and dies takes it with it. Printing usage proves the script starts.
# BEFORE `current` MOVES, so a release that cannot start is one this box never
# points at, and the failure is a sentence instead of a half-converted machine.
[ -x "$WORK/release/install/install.sh" ] || die "the release has no install/install.sh in it"
if ! bash "$WORK/release/install/install.sh" --help >/dev/null 2>"$WORK/smoke.err"; then
  say "the installer inside $VERSION does not run:"
  sed 's/^/    /' "$WORK/smoke.err" >&2
  die "refusing to use a release whose installer cannot start. Nothing was changed.
       A newer release will carry the fix; until then this box is fine as it is."
fi

# THE HEAL. The box is already on this version; what is stale is root's half.
#
# FROM THE VERIFIED COPY, NOT FROM `current` AND NOT FROM THE CHECKOUT. Both of
# those are writable by the service user — applyRelease swaps `current` as that
# user, and install.sh chowns the checkout so /update can pull — and a root
# shell running a script the service user can rewrite is root with extra
# steps. The tree unpacked here is root-owned, in a temp directory only root
# can reach, from a tarball whose sha256 the operator's own manifest vouched
# for. That is what root may run. The bring-forward path below keeps preferring
# the checkout's installer for the reason its comment gives; this path has no
# checkout to prefer and no reason to want one.
#
# --repair rather than --upgrade: --upgrade rewrites the units, the hook and
# the directories; --repair also re-applies the sudoers rules from the answers
# already in the env file, which is the drift a shell used to be the only cure
# for. Neither asks a question. The installer restarts the services itself,
# agent-hub included, and KillMode=process is what lets this helper outlive the
# process that called it.
if [ "$HEAL" = yes ]; then
  say "running the installer from the verified release, with --repair"
  AGENT_FLEET_PAYLOAD="$BASE/current" bash "$WORK/release/install/install.sh" --repair
  exit $?
fi

mkdir -p "$BASE/releases"
rm -rf "$BASE/releases/.incoming-$VERSION"
mkdir -p "$BASE/releases/.incoming-$VERSION"
tar -xzf "$WORK/$FILE" -C "$BASE/releases/.incoming-$VERSION" --strip-components=1
rm -rf "$BASE/releases/$VERSION"
mv "$BASE/releases/.incoming-$VERSION" "$BASE/releases/$VERSION"

# Replaced atomically, for the reason install.sh gives: a symlink that briefly
# does not exist is a service that briefly cannot start.
ln -sfn "$BASE/releases/$VERSION" "$BASE/.current.new"
mv -Tf "$BASE/.current.new" "$BASE/current"
say "laid out $BASE/releases/$VERSION"

# AND THE INSTALLER DOES THE REST. It already knows how to template units for a
# packaged layout, keep the env files it finds, and restart what it started —
# --upgrade is exactly "an already-configured box, brought onto new code, with
# no questions". Reimplementing any of that here would be a second installer
# that is subtly different on the day it matters.
#
# FROM THE VERIFIED COPY, and the history of this line is worth keeping.
#
# It first ran the installer out of the release under `current`, which made a
# release's installer load-bearing for its own adoption: three releases in one
# afternoon, each fixing a bug the last had hidden. It then ran THE BOX'S OWN
# installer — the checkout, refreshed by `curl … | sudo sh` — pointed at the
# release as payload, so an installer fix reached a machine without a release.
#
# That second shape had a cost the comment did not name. install.sh chowns the
# checkout to the service user so /update can pull, which means the script
# this line executed as root was one the service user could rewrite — the
# exact grant the header of this file says it refuses. The heal path below
# solved that for a box already on its version by unpacking the verified
# tarball somewhere only root can reach and running THAT installer; this path
# now does the same, so root runs only what the operator's manifest vouched
# for, on both routes through this file.
#
# What it gives back: a broken release installer can again strand its own
# adoption. What guards that: the --help smoke check above refuses the release
# before `current` moves, and #471 made the release's installer the thing that
# heals a box anyway — a release has to carry a correct installer now, and CI
# runs it (test/packaged-installer.test.js) so one that does not never ships.
say "running the installer from the verified release"
AGENT_FLEET_PAYLOAD="$BASE/current" exec bash "$WORK/release/install/install.sh" --upgrade
