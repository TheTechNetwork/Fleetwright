# fleetwright sidecar configuration.
#
# Copy to /etc/fleetwright-sidecar.env (mode 0600) and fill in. This is separate
# from /etc/fleetwright.env on purpose: the two processes run with different
# privileges and hold different secrets, and merging them would mean the session
# manager's environment carries the fleet's coordinator credential for no reason.
#
# Only two lines usually need changing: the coordinator URL and the hub token.
# Everything below them has a working default, and every one of them is here —
# a setting that lives only in a paragraph in docs/ is a setting the person
# editing this file will never find. `test/host-env-documented.test.js` keeps
# that true in both directions.

# --- the coordinator ---------------------------------------------------------
# REQUIRED. The origin this sidecar will talk to, and only that origin.
#
# The sidecar refuses to start without one. A host agent that will talk to
# whoever answers is the same shape of mistake as accepting shell strings from
# the wire — see docs/intents.md.
#
# The fleet coordinator:
#   FLEETWRIGHT_COORDINATOR_URL=https://fleet.thetech.network
#
# For driving one sidecar by hand over the stdio transport instead, a local
# placeholder is enough:
#   FLEETWRIGHT_COORDINATOR_URL=stdio:local
FLEETWRIGHT_COORDINATOR_URL=

# Which transport to dial the coordinator over. `websocket` is the real one: a
# persistent outbound connection, so nothing on this box ever listens. `stdio`
# speaks the same protocol on stdin/stdout, for driving one sidecar by hand.
FLEETWRIGHT_TRANSPORT=websocket

# --- this box's identity -----------------------------------------------------
# The private key that makes this machine itself. Generated on first run, 0600,
# in a directory systemd creates 0700 for this service.
#
# There is no shared host token any more. Connecting means signing a nonce the
# coordinator issued seconds earlier, so nothing reusable ever crosses the wire
# and a host can be revoked one at a time. Present the public half once:
#
#   sudo -u <service user> fleetwright-sidecar enrol 123456
#
# where the six digits come from /enroll in the app. Copying this file to
# another box is fine; copying the key file is not — two machines with one
# identity is the problem this replaced.
FLEETWRIGHT_HOST_KEY=/var/lib/fleetwright-sidecar/host-key.json

# --- the session manager this sidecar drives ---------------------------------
# Where fleetwright listens. Loopback, because the sidecar is meant to run on the
# same box; pointing this off-box means that control port is on a routable
# interface, and the sidecar warns about it.
FLEETWRIGHT_HUB_URL=http://127.0.0.1:8790

# The sidecar's own token, which the hub mints at <state dir>/sidecar-token and
# install.sh copies here — the sidecar runs as its own account and cannot read
# the hub's files itself. The hub lets this token run the routes and the
# command shapes the sidecar uses and nothing else: not the web UI, not a bare
# /login, which signs the box in. The operator's token (FLEETWRIGHT_TOKEN in
# /etc/fleetwright.env, or the hub's generated api-token) also works here and
# is gated to nothing, which is how every box ran before the second token
# existed.
#
# Holding this is still the sidecar's real privilege: the fleet's verbs ARE
# start, stop and link. The verb allowlist in the sidecar is what stands
# between the coordinator and that endpoint, which is why it never builds a
# command line out of anything that arrived on the wire.
FLEETWRIGHT_HUB_TOKEN=

# Where the hub keeps its state, and so its tokens: read from there when
# FLEETWRIGHT_HUB_TOKEN above is empty — sidecar-token first, then api-token —
# which works only where both services run as one user (a Mac, a runner, a
# checkout by hand). The hub's own setting, shared by name, so the default is
# the hub's default and this line is only for a box that moved it.
#FLEETWRIGHT_STATE_DIR=/var/lib/fleetwright

# How long to wait on the hub. The command timeout is generous on purpose and
# matches fleetwright's own CLI: a start waits out the Remote Control check (up to
# ~2x10s), a resume waits for the resume dialog to render. A short timeout here
# reports a perfectly healthy hub as unreachable.
FLEETWRIGHT_HUB_COMMAND_TIMEOUT_MS=300000
FLEETWRIGHT_HUB_READ_TIMEOUT_MS=10000

# --- this host ---------------------------------------------------------------
# How the coordinator names this box. Defaults to the system hostname.
FLEETWRIGHT_HOST_ID=

# Constraint labels the scheduler filters on before ranking by free capacity —
# e.g. gpu,debian13,has-monorepo. Comma separated.
FLEETWRIGHT_LABELS=

# --- replay protection -------------------------------------------------------
# How far from now an intent's issuedAt may be, in milliseconds. This bounds
# replay on top of the per-intent idempotency key.
#
# It MUST stay below the sidecar's replay cache TTL (10 minutes) and the process
# refuses to start otherwise. Above it there is a band — older than the cache,
# younger than the skew limit — where a replayed `start` passes the freshness
# check against a cache that has already forgotten it, and runs a second time.
#
# Set 0 to disable, which is the right answer if this box's clock is not
# reliably synchronised: a wrong clock with this enabled rejects everything.
FLEETWRIGHT_MAX_SKEW_MS=300000

# --- what a notification is allowed to say -----------------------------------
# May a notification quote the SESSION — a path, a command line, the thing
# Claude is asking about — or only the question this fleet wrote?
#
# Off, and the default is the cautious one on purpose. The fuller form travels
# to a lock screen through Apple's or Google's servers, and the fleet may not
# belong to the person holding the phone. Turning it on is a decision about
# whose screen this text may appear on, not a verbosity setting.
#
# End-to-end encryption changes the calculation and does not remove it: a phone
# that registered a public key gets a sealed envelope nobody in between can
# read, but a phone that did not still gets the plain text. See
# docs/push-encryption.md and src/fleet/host/prompt.js.
#FLEETWRIGHT_PROMPT_TEXT=0

# --- the watchdog ------------------------------------------------------------
# How long a session's pane may sit COMPLETELY unchanged before it is stopped
# and resumed. 0 turns it off.
#
# An hour, and deliberately generous. What this catches is a session that
# wedged overnight, where the fix is mechanical and nobody was awake to do it.
# What it must not do is kill a session that is genuinely working with a quiet
# pane — a long build, a big test run — and the two mistakes do not cost the
# same: a wedged session recovers an hour late, a restarted one loses the work
# that was happening.
#
# A session sitting at a prompt is never touched however long it waits. That
# pane is still because somebody has to answer it.
#FLEETWRIGHT_IDLE_RESTART_MINUTES=60

# --- repository tokens for runners --------------------------------------------
# ON ONE PERMANENT BOX, and only if you want runners to reach private code. This
# box then mints a runner a one-hour GitHub token for the one repository its
# session asked for — see docs/runner-central.md for what bounds it. The key
# mints for every installation of the App, so it goes on one hardened box and
# nowhere else (docs/github-app.md); prefer handing it to the unit as an
# encrypted systemd credential named github-app-key, which needs no path here.
#FLEETWRIGHT_GITHUB_APP_KEY=/etc/fleetwright/github-app.pem
#FLEETWRIGHT_GITHUB_APP_CLIENT_ID=Iv23li...
# Whose repositories it may mint into. Empty is nobody — the App is installable
# by any account, and this is where "not a guest's" is decided.
#FLEETWRIGHT_GITHUB_MINT_OWNERS=your-org
#
# ON A RUNNER, set by its workflow, never here: the socket its sessions' git
# asks for those tokens on.
#   FLEETWRIGHT_RUNNER_BROKER=$RUNNER_TEMP/state/broker.sock
#
# ON A MACHINE FROM A HYPERVISOR, set by its join script, never by hand: the
# file it was booted with, which it enrols itself with once and then deletes
# (install/fleetwright-vm-join, docs/hypervisors.md).
#   FLEETWRIGHT_VM_JOIN=/var/lib/fleetwright-sidecar/vm-join.json
#
# ON A POOL'S OWN MACHINE, set by the same script: the Xen Orchestra it was
# made to hold. Its health says so, and the fleet asks it first for that
# pool's machines (src/fleet/host/xo-holder.js).
#   FLEETWRIGHT_HOLDER_FOR=xo.lan

# --- enrolling, and where this file is read from -----------------------------
# Neither of these belongs IN this file, and they are named here because that
# is the sentence somebody needs.
#
# FLEETWRIGHT_SIDECAR_ENV_FILE is read from the sidecar's own environment before
# this file is loaded, so setting it here does nothing — it is what the unit
# passes when the file lives somewhere other than /etc/fleetwright-sidecar.env.
#
# FLEETWRIGHT_ENROL_QUIET=1 drops the "what to do next" paragraph that
# `fleetwright-sidecar enrol` prints, for a provisioning script that is going to
# start the unit itself and does not want the advice.
#
#   FLEETWRIGHT_SIDECAR_ENV_FILE=/etc/fleetwright-sidecar.env
#   FLEETWRIGHT_ENROL_QUIET=0

# --- logging -----------------------------------------------------------------
# debug | info | warn | error
FLEETWRIGHT_LOG_LEVEL=info
