[Unit]
Description=agent-hub — Claude Code session manager
Documentation=https://github.com/ambersecurityinc/agent-hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __USER__ / __DIR__ / __NODE__ / __ENTRY__ are substituted by install.sh.
#
# __ENTRY__ IS WHAT NODE RUNS, and it is computed rather than written here
# because the answer differs between the two shapes an install can take. A
# checkout's bin/<name> is JavaScript; a release ships lib/<name>.mjs plus a
# thin bin/ shim. This used to say __DIR__/bin/<name> for both, so on a release
# systemd ran `node <shim>` — and when that shim was a shell script, every
# service died at startup with a syntax error. Naming the module removes the
# shim from the path systemd takes at all.
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=/etc/agent-hub.env
ExecStart=__NODE__ __ENTRY__ serve

Restart=always
RestartSec=3

# KillMode=process is LOAD-BEARING — do not remove it.
#
# The tmux server that holds every Claude session is started by this service,
# so it lands in this unit's cgroup. With the default KillMode=control-group, a
# plain `systemctl restart agent-hub` reaps the entire cgroup — including the
# tmux server — and takes down every live session at once. That is exactly what
# happened on the fleet this was extracted from: one routine restart, every
# agent gone.
#
# With KillMode=process, systemd signals only the main process, so restarting
# the hub leaves the sessions alone and they are re-adopted on the next
# reconcile. Restarting agent-hub must never cost anyone their work.
KillMode=process
TimeoutStopSec=15

# --- Hardening ---------------------------------------------------------------
#
# EVERY LINE HERE WAS MEASURED, not chosen from a checklist: `systemd-run` with
# one property at a time, running `podman run --rm alpine true`, on a real
# systemd. The REJECTED list below is the valuable half — this unit runs
# rootless podman AND a tmux server that a person attaches to from their own
# shell, and most of what a hardening guide recommends breaks one or the other
# silently. docs/hardening.md has the table and how to re-run it.
#
# Owner-only by default. The credential writers chmod explicitly; this closes
# the window between create and chmod rather than replacing the chmod.
UMask=0077
ProtectClock=yes
ProtectKernelModules=yes
# `no`, AND THIS IS THE THIRD ATTEMPT, SO THE REASONING IS WRITTEN OUT IN FULL.
#
# This service's ONE privileged operation is `sudo -n apt-get -y upgrade`,
# granted by a sudoers rule naming that exact command line. Rewriting /usr, /etc
# and /boot IS WHAT THAT COMMAND IS. Every setting of ProtectSystem forbids some
# of it, and a mount namespace is not something `sudo` escapes, so the sanctioned
# upgrade inherits whatever this line says.
#
# Watch the failure walk from one protected path to the next:
#
#   full   → unable to create '/etc/debian_version.dpkg-new': Read-only file system
#   +ReadWritePaths=/etc
#          → systemd loaded it, reported ReadWritePaths=/etc and no drop-ins,
#            and left /etc read-only anyway. Measured on the box.
#   true   → unable to create '/usr/bin/locale-check.dpkg-new': Read-only file system
#
# Three rounds, each fixing the path in the last error and uncovering the next.
# `true` still protects /usr and /boot, and dpkg writes both, so it was never
# going to be the last one. There is no setting of this that lets apt work.
#
# WHAT IS ACTUALLY GIVEN UP IS SMALL, AND WORTH STATING PRECISELY RATHER THAN
# WAVING AT. The service runs as an UNPRIVILEGED USER. Ordinary file permissions
# already stop it writing /usr, /boot and /etc — the namespace was redundant for
# everything it does on its own account. It was load-bearing only against a
# service that had somehow gained privileges — and the privilege this one is
# granted is `apt-get -y upgrade`, which rewrites those directories as its
# purpose. ProtectSystem was defending the door that the sudoers rule holds open
# on purpose.
#
# THE HARDENING CAN COME BACK, AND HERE IS HOW. Give the upgrade its own
# oneshot unit with no sandboxing, and grant this service `systemctl start
# agent-hub-upgrade.service` and nothing else. agent-hub keeps ProtectSystem,
# dpkg gets a clean namespace, and the sudoers grant narrows from "run apt as
# root" to "start one named unit". That is the right shape and it is not built —
# it changes how output is captured and how failures are detected, and this box
# has been unable to take a security update through four rounds of this.
ProtectSystem=no
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
StateDirectory=agent-hub
StateDirectoryMode=0700
RuntimeDirectory=agent-hub
RuntimeDirectoryMode=0700
#
# REJECTED, each with what actually happened:
#
#   NoNewPrivileges       newuidmap/newgidmap are setuid-root and are how
#                         rootless podman gets a user namespace. Measured: a
#                         setuid binary under this reports euid 65534 instead
#                         of 0 — it does not fail, it silently does nothing,
#                         which is the worst shape of breakage there is.
#   RestrictSUIDSGID      podman does not start: crun dies with "cannot resolve
#                         `null` under rootfs". It would also stop a session
#                         doing `apt install sudo`, which creates a setuid file.
#   PrivateTmp            tmux's socket lives in /tmp/tmux-<uid>. Measured: a
#                         tmux server started under this is invisible to
#                         `tmux ls` from the user's own shell, so every
#                         `agent-hub attach` stops working.
#   ProtectHome           rootless podman keeps its storage in
#                         ~/.local/share/containers, and the Claude credential
#                         is in ~/.claude.
#   ProtectSystem=strict  podman run fails.
#   ProtectSystem=full    dpkg cannot write /etc. Tried with ReadWritePaths=/etc
#                         to carve it back out; systemd loaded that unit and
#                         left /etc read-only anyway, measured on a real box.
#   ProtectSystem=true    dpkg cannot write /usr. This is the one that shows
#                         there is no working setting: the sudoers grant is
#                         `apt-get -y upgrade`, whose job is rewriting exactly
#                         the directories every level of this protects. See the
#                         note above ProtectSystem= for the way out.
#   ProtectKernelTunables podman run fails.
#   ProtectControlGroups  podman run fails; it writes its own cgroup.
#   ProtectHostname       podman run fails.
#   ProtectProc=invisible mounts this service's /proc hidepid — and rootless
#                         podman keeps ONE pause process per user whose
#                         namespaces every container joins, so the hidepid /proc
#                         gets baked into that shared pause namespace. A hidepid
#                         /proc is not "fully visible", so the kernel refuses an
#                         unprivileged container a fresh proc mount: every
#                         session dies at start with `crun: mount \`proc\` to
#                         \`proc\`: Operation not permitted` — an error that
#                         blames crun and points at the wrong thing entirely.
#                         It cost a fleet-wide outage: added before it survived
#                         the `podman run --rm alpine true` test, dormant until
#                         the release-first update re-applied this unit and each
#                         box's next session-start created a poisoned pause.
#                         REMOVING IT IS NOT ENOUGH ON A BROKEN BOX: the poisoned
#                         pause outlives a restart (KillMode=process leaves the
#                         user's pause alone), so agent-hub recreates it on the
#                         way up — see healRootlessSandbox — which is what makes
#                         an in-app update recover the box. The sidecar keeps
#                         this directive: it spawns nothing, so it has no pause.
#   ProtectKernelLogs=yes THE SAME FAILURE, one directive over, and it is why
#                         dropping ProtectProc alone did not fix the fleet. It
#                         overmounts /proc/kmsg onto systemd's inaccessible
#                         marker — which ALSO makes /proc not "fully visible", so
#                         the container's fresh proc mount is refused with the
#                         identical `mount \`proc\` to \`proc\`: Operation not
#                         permitted`. The mask rides into the shared pause
#                         namespace exactly like hidepid did. Measured: a pause
#                         created without this directive mounts proc; one created
#                         with it does not, same box, same kernel. Kernel-version
#                         sensitive like ProtectProc — it was tolerated on older
#                         kernels and is not on the fleet's. The sidecar keeps it
#                         — it spawns nothing, so it has no pause.
#   PrivateDevices        podman run fails, and it implies NoNewPrivileges.
#   RestrictNamespaces    a container IS namespaces.
#   SystemCallFilter      deliberately not attempted: the filter applies to
#                         every child, and every child here includes crun and
#                         whatever a session installs and runs. The sidecar
#                         takes it instead — one Node process, no descendants.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-hub

[Install]
WantedBy=multi-user.target
