[Unit]
Description=agent-hub — Claude Code session manager
Documentation=https://github.com/ambersecurityinc/agent-hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __USER__ / __DIR__ / __NODE__ / __ENTRY__ are substituted by install.sh.
#
# __ENTRY__ IS WHAT NODE RUNS, and it is computed rather than written here
# because the answer differs between the two shapes an install can take. A
# checkout's bin/<name> is JavaScript; a release ships lib/<name>.mjs plus a
# thin bin/ shim. This used to say __DIR__/bin/<name> for both, so on a release
# systemd ran `node <shim>` — and when that shim was a shell script, every
# service died at startup with a syntax error. Naming the module removes the
# shim from the path systemd takes at all.
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=/etc/agent-hub.env
ExecStart=__NODE__ __ENTRY__ serve

Restart=always
RestartSec=3

# KillMode=process is LOAD-BEARING — do not remove it.
#
# The tmux server that holds every Claude session is started by this service,
# so it lands in this unit's cgroup. With the default KillMode=control-group, a
# plain `systemctl restart agent-hub` reaps the entire cgroup — including the
# tmux server — and takes down every live session at once. That is exactly what
# happened on the fleet this was extracted from: one routine restart, every
# agent gone.
#
# With KillMode=process, systemd signals only the main process, so restarting
# the hub leaves the sessions alone and they are re-adopted on the next
# reconcile. Restarting agent-hub must never cost anyone their work.
KillMode=process
TimeoutStopSec=15

# --- Hardening ---------------------------------------------------------------
#
# EVERY LINE HERE WAS MEASURED, not chosen from a checklist: `systemd-run` with
# one property at a time, running `podman run --rm alpine true`, on a real
# systemd. The REJECTED list below is the valuable half — this unit runs
# rootless podman AND a tmux server that a person attaches to from their own
# shell, and most of what a hardening guide recommends breaks one or the other
# silently. docs/hardening.md has the table and how to re-run it.
#
# Owner-only by default. The credential writers chmod explicitly; this closes
# the window between create and chmod rather than replacing the chmod.
UMask=0077
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectProc=invisible
# `true` AND NOT `full`, WHICH IS THE SECOND ATTEMPT AT THIS.
#
# `full` adds /etc to the /usr and /boot that `true` already protects. The one
# thing this service exists to launch writes /etc — a mount namespace is not
# something `sudo` escapes, so the sanctioned `sudo -n apt-get upgrade`
# inherited it too:
#
#   unable to create '/etc/debian_version.dpkg-new'
#     (while processing './etc/debian_version'): Read-only file system
#
# Reported from a box whose filesystem is perfectly writable. It was ours, and
# `/upgrade` could not have worked on any box carrying this unit, for any
# package with a conffile — which is most of them.
#
# THE FIRST ATTEMPT WAS `full` PLUS `ReadWritePaths=/etc`, AND IT DID NOT WORK.
# Measured on the box that reported it, after the fix had been installed:
#
#   systemctl show → ProtectSystem=full  ReadWritePaths=/etc  DropInPaths=
#   /proc/<pid>/mountinfo → 8:1 /etc /etc ro,relatime - ext4 /dev/sda1 rw,...
#
# The unit asks for it, systemd loaded the unit, nothing overrides it, and /etc
# is still read-only in the namespace. I do not know why that resolves this way
# here and not elsewhere, and three wrong explanations of this exact failure is
# enough — so this stops asking systemd to resolve a contradiction rather than
# trying to win the argument about precedence.
#
# `full` and `ReadWritePaths=/etc` ARE a contradiction: protect /etc, and do not
# protect /etc. Whichever way a given systemd resolves it is a detail of that
# version, and a unit whose correctness depends on it is a unit that works on
# the boxes we tested and not the ones we did not.
#
# WHAT IS ACTUALLY LOST IS LESS THAN IT LOOKS. /usr, /boot and /efi stay
# read-only, which is the part that matters for a service that should never
# rewrite its own runtime. /etc goes back to being guarded by ordinary file
# permissions — and the service runs as an UNPRIVILEGED USER, so those already
# stop it writing /etc. The namespace was redundant for everything except the
# one operation that legitimately has root, through a sudoers rule naming that
# exact command line. It blocked the sanctioned path while permissions did the
# real work.
ProtectSystem=true
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
StateDirectory=agent-hub
StateDirectoryMode=0700
RuntimeDirectory=agent-hub
RuntimeDirectoryMode=0700
#
# REJECTED, each with what actually happened:
#
#   NoNewPrivileges       newuidmap/newgidmap are setuid-root and are how
#                         rootless podman gets a user namespace. Measured: a
#                         setuid binary under this reports euid 65534 instead
#                         of 0 — it does not fail, it silently does nothing,
#                         which is the worst shape of breakage there is.
#   RestrictSUIDSGID      podman does not start: crun dies with "cannot resolve
#                         `null` under rootfs". It would also stop a session
#                         doing `apt install sudo`, which creates a setuid file.
#   PrivateTmp            tmux's socket lives in /tmp/tmux-<uid>. Measured: a
#                         tmux server started under this is invisible to
#                         `tmux ls` from the user's own shell, so every
#                         `agent-hub attach` stops working.
#   ProtectHome           rootless podman keeps its storage in
#                         ~/.local/share/containers, and the Claude credential
#                         is in ~/.claude.
#   ProtectSystem=strict  podman run fails.
#   ProtectSystem=full    /etc read-only for every child too, and dpkg writes
#                         there. Tried with ReadWritePaths=/etc to carve it back
#                         out; measured on a real box, systemd loaded that unit
#                         and left /etc read-only anyway. See the note above
#                         ProtectSystem= for the measurement. `true` is what
#                         this needs, and it keeps /usr and /boot.
#   ProtectKernelTunables podman run fails.
#   ProtectControlGroups  podman run fails; it writes its own cgroup.
#   ProtectHostname       podman run fails.
#   PrivateDevices        podman run fails, and it implies NoNewPrivileges.
#   RestrictNamespaces    a container IS namespaces.
#   SystemCallFilter      deliberately not attempted: the filter applies to
#                         every child, and every child here includes crun and
#                         whatever a session installs and runs. The sidecar
#                         takes it instead — one Node process, no descendants.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-hub

[Install]
WantedBy=multi-user.target
