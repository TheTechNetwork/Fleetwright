[Unit]
Description=agent-fleet coordinator — where the fleet meets
Documentation=https://github.com/TheTechNetwork/Fleetwright
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __USER__ / __DIR__ / __NODE__ / __ENTRY__ are substituted by install.sh.
#
# __ENTRY__ IS WHAT NODE RUNS, and it is computed rather than written here
# because the answer differs between the two shapes an install can take. A
# checkout's bin/<name> is JavaScript; a release ships lib/<name>.mjs plus a
# thin bin/ shim. This used to say __DIR__/bin/<name> for both, so on a release
# systemd ran `node <shim>` — and when that shim was a shell script, every
# service died at startup with a syntax error. Naming the module removes the
# shim from the path systemd takes at all.
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=/etc/agent-fleet-coordinator.env
ExecStart=__NODE__ __ENTRY__

Restart=always
RestartSec=3

# The registry is still a cache — hosts reconnect on their own and their
# sessions are untouched. What DOES have to survive is the membership list:
# which hosts are enrolled, and their public keys. Lose that and every box in
# the fleet is refused until somebody re-enrols it by hand.
StateDirectory=agent-fleet-coordinator
StateDirectoryMode=0700

KillMode=control-group
TimeoutStopSec=10

# It talks to hosts and to clients, and writes exactly one file — the state
# directory above, which ProtectSystem=strict leaves writable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-fleet-coordinator

[Install]
WantedBy=multi-user.target
