[Unit]
Description=agent-fleet sidecar — this box, as a fleet host
Documentation=https://github.com/TheTechNetwork/Fleetwright
After=network-online.target agent-hub.service
Wants=network-online.target
# Not Requires=: the sidecar deliberately stays up when agent-hub is down, and
# reports "hub unreachable" rather than disappearing from the fleet. A host that
# can tell you it is broken is worth more than one that is silently absent.
After=agent-hub.service

[Service]
Type=simple
# __USER__ / __DIR__ / __NODE__ / __ENTRY__ are substituted by install.sh.
#
# __ENTRY__ IS WHAT NODE RUNS, and it is computed rather than written here
# because the answer differs between the two shapes an install can take. A
# checkout's bin/<name> is JavaScript; a release ships lib/<name>.mjs plus a
# thin bin/ shim. This used to say __DIR__/bin/<name> for both, so on a release
# systemd ran `node <shim>` — and when that shim was a shell script, every
# service died at startup with a syntax error. Naming the module removes the
# shim from the path systemd takes at all.
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=/etc/agent-fleet-sidecar.env
ExecStart=__NODE__ __ENTRY__

Restart=always
RestartSec=3

# The per-session hook sockets live here. systemd creates it 0700 owned by this
# user, which is what lets an unprivileged sidecar serve them at all — /run is
# not writable by a normal user. It is removed when the service stops, and /run
# is tmpfs, so there is nothing to clean up.
RuntimeDirectory=agent-fleet
RuntimeDirectoryMode=0700

# This box's private key lives here — /var/lib/agent-fleet, created 0700 owned
# by this user before the service starts. It is the whole of this host's
# identity in the fleet: whoever can read it can be this machine, and nothing
# else can. Deliberately NOT under /etc with the env file, because the env file
# is a config file people copy between boxes and this must never be copied.
StateDirectory=agent-fleet
StateDirectoryMode=0700

# It holds no session state and stopping it must never disturb a session — the
# same reasoning as agent-hub's own shutdown.
KillMode=control-group
TimeoutStopSec=10


# --- Hardening ---------------------------------------------------------------
#
# MUCH HARDER THAN agent-hub.service, and that is not an inconsistency — it is
# the difference between the two processes. This one spawns nothing: it is a
# single Node process that talks WebSocket to the coordinator and HTTP to
# 127.0.0.1:8790, and every directive rejected next door was rejected because
# of podman or tmux, neither of which exists here.
#
# Measured the same way — `systemd-run` with the whole set, running a probe that
# does what this actually does: write and chmod a 0600 file in the state
# directory, sign with ed25519, listen on loopback, and make an HTTP request.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=read-only
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
UMask=0077
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
# EPERM RATHER THAN SIGSYS, and this line is why the filter is usable at all.
# Measured: with the default action, `@system-service` kills Node outright —
# status=31/SYS, before it prints anything. Node makes a call outside that set
# and tolerates being refused, but not being shot. The syscall is denied either
# way; this chooses which of "denied" and "dead" the process gets.
SystemCallErrorNumber=EPERM
#
# ProtectHome is READ-ONLY rather than yes: the sidecar reads the account and
# connection files that live under the hub's state directory, which may be in
# $HOME on a box installed from a checkout. Writing them is agent-hub's job.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-fleet-sidecar

[Install]
WantedBy=multi-user.target
