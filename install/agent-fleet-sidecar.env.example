# agent-fleet sidecar configuration.
#
# Copy to /etc/agent-fleet-sidecar.env (mode 0600) and fill in. This is separate
# from /etc/agent-hub.env on purpose: the two processes run with different
# privileges and hold different secrets, and merging them would mean the session
# manager's environment carries the fleet's coordinator credential for no reason.
#
# Only two lines usually need changing: the coordinator URL and the hub token.

# --- the coordinator ---------------------------------------------------------
# REQUIRED. The origin this sidecar will talk to, and only that origin.
#
# The sidecar refuses to start without one. A host agent that will talk to
# whoever answers is the same shape of mistake as accepting shell strings from
# the wire — see docs/intents.md.
#
# There is no coordinator yet. For local driving over the stdio transport, use
# a placeholder:
#   AGENT_FLEET_COORDINATOR_URL=stdio:local
AGENT_FLEET_COORDINATOR_URL=

# Which transport to dial the coordinator over. `stdio` (newline-delimited JSON
# on stdin/stdout) is the only one implemented — the WebSocket transport lands
# with the coordinator.
AGENT_FLEET_TRANSPORT=stdio

# --- the session manager this sidecar drives ---------------------------------
# Where agent-hub listens. Loopback, because the sidecar is meant to run on the
# same box; pointing this off-box means that control port is on a routable
# interface, and the sidecar warns about it.
AGENT_FLEET_HUB_URL=http://127.0.0.1:8790

# Must match AGENT_HUB_TOKEN in /etc/agent-hub.env. Leave empty if the hub is
# loopback-bound with no token, which is its default.
#
# Holding this is the sidecar's real privilege: POST /api/command runs ANY
# command line it is handed, /login included. The verb allowlist in the sidecar
# is the only thing standing between the coordinator and that endpoint, which is
# why it never builds a command line out of anything that arrived on the wire.
AGENT_FLEET_HUB_TOKEN=

# How long to wait on the hub. The command timeout is generous on purpose and
# matches agent-hub's own CLI: a start waits out the Remote Control check (up to
# ~2x10s), a resume waits for the resume dialog to render. A short timeout here
# reports a perfectly healthy hub as unreachable.
AGENT_FLEET_HUB_COMMAND_TIMEOUT_MS=300000
AGENT_FLEET_HUB_READ_TIMEOUT_MS=10000

# --- this host ---------------------------------------------------------------
# How the coordinator names this box. Defaults to the system hostname.
AGENT_FLEET_HOST_ID=

# Constraint labels the scheduler filters on before ranking by free capacity —
# e.g. gpu,debian13,has-monorepo. Comma separated.
AGENT_FLEET_LABELS=

# --- replay protection -------------------------------------------------------
# How far from now an intent's issuedAt may be, in milliseconds. This bounds
# replay on top of the per-intent idempotency key.
#
# It MUST stay below the sidecar's replay cache TTL (10 minutes) and the process
# refuses to start otherwise. Above it there is a band — older than the cache,
# younger than the skew limit — where a replayed `start` passes the freshness
# check against a cache that has already forgotten it, and runs a second time.
#
# Set 0 to disable, which is the right answer if this box's clock is not
# reliably synchronised: a wrong clock with this enabled rejects everything.
AGENT_FLEET_MAX_SKEW_MS=300000

# --- per-session hook sockets ------------------------------------------------
# One unix socket per sandboxed session, bind-mounted into that container and
# nowhere else, so a container can report its conversation uuid without being
# able to name any session but its own. See docs/hook-socket.md.
#
# The directory lives on tmpfs and is created 0700 on demand. If the sidecar
# runs as a non-root user it needs to be able to create it — see the
# RuntimeDirectory note in docs/deployment.md.
AGENT_FLEET_HOOK_SOCKETS=1
AGENT_FLEET_HOOK_SOCKET_DIR=/run/agent-fleet

# --- logging -----------------------------------------------------------------
# debug | info | warn | error
AGENT_FLEET_LOG_LEVEL=info
