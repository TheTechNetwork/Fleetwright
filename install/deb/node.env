# The Node the deb carries, in /usr/lib/fleetwright/node. Read by
# tools/build-host-deb.mjs, and bumped by Renovate — `versioning=node` treats a
# release line as stable only once it reaches LTS, so this follows LTS and
# never a Current line that has not earned it yet.
#
# Shipping the runtime is what makes the package one `apt install`: Debian's
# nodejs is older than package.json's floor, and the alternatives were a second
# third-party repository (NodeSource) or nvm in somebody's home. Renovate is
# what keeps "we ship it" from turning into "we ship an old one": a Node
# security release arrives here as a PR like every other dependency, with no
# three-day soak (renovate.json, vulnerabilityAlerts).
# renovate: datasource=node-version depName=node versioning=node
NODE_VERSION=24.21.0
