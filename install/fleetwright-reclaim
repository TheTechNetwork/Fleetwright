#!/bin/sh
# Remove the release directories prune could not. Root, no arguments.
#
#   sudo -n /usr/local/sbin/fleetwright-reclaim
#
# WHY THIS EXISTS. A packaged box updates entirely as the service user — fetch,
# verify, unpack, swap a symlink, prune the old releases. Prune is the one step
# that can meet a thing the service user cannot touch: a legacy release left
# root-owned by an old `sudo` install (docs/deployment.md, "why the pull is not
# sudo"). It cannot `rm` a root-owned tree, so instead it renames that directory
# aside to `.stale-<name>` (a rename needs write on `releases/` only, which it
# has) and carries on. Reclaiming the disk is the one step that needs root, and
# this is it — the same shape as fleetwright-migrate: a narrow, root-owned helper
# the service user may run through one sudoers rule and cannot rewrite.
#
# WHAT IT WILL AND WILL NOT TOUCH, stated plainly because a root grant nobody
# has bounded is a grant nobody can review:
#
#   ONLY direct children of <base>/releases whose names begin with `.stale-`.
#   Nothing else, ever — not a live release, not `current`, not a path outside
#   the release tree. Even as root, this removes only what prune already gave up
#   on and quarantined, which is the whole point of the two gates: a normal
#   removal has to FAIL FIRST for a `.stale-` entry to exist, and then this can
#   remove only entries of that one shape.
#
# NO ARGUMENTS, for the reason the other rules spell their command lines out:
# sudoers matches argv, and every argument is a widening.
#
# AND NOTHING FROM THE ENV FILE. The base was read out of /etc/fleetwright.env
# as FLEETWRIGHT_INSTALL_DIR, "the root-owned env file" — which it is not:
# install.sh chowns it to the service user so the CLI can read it (see
# fleetwright-migrate's header, which said the same thing and was wrong the
# same way). So the directory whose releases/.stale-* root removes was one
# the service user named. The installer never writes that setting, so every
# box read the default anyway; it is now the default, or FLEETWRIGHT_BASE,
# which sudo's env_reset strips — the same base fleetwright-migrate uses.
set -eu

log() { printf '%s\n' "$*"; }

# BEING ABLE TO WRITE IS THE REQUIREMENT, NOT BEING ROOT — the same rule
# fleetwright-migrate and bootstrap.sh state, so the whole path is testable
# against a temporary tree instead of only ever on a real box.
BASE="${FLEETWRIGHT_BASE:-/opt/fleetwright}"

RELEASES="$BASE/releases"
[ -d "$RELEASES" ] || { log "no $RELEASES — nothing to reclaim"; exit 0; }

# A glob, which lists DIRECT CHILDREN only — it never recurses — so this cannot
# reach past releases/ into a nested path. `[ -e ]` is the guard for the
# no-match case: an unmatched glob expands to the literal `.stale-*`, which is
# not a real path, so it is skipped rather than handed to rm. `rm -rf` on a
# `.stale-` that is itself a symlink removes the link, not its target.
found=0
for entry in "$RELEASES"/.stale-*; do
  [ -e "$entry" ] || [ -L "$entry" ] || continue    # the no-match case
  found=1
  rm -rf -- "$entry"
  log "reclaimed $(basename "$entry")"
done
[ "$found" = 1 ] || log "no quarantined releases to reclaim"
exit 0
