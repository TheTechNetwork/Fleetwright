[Unit]
Description=fleetwright sidecar — this box, as a fleet host
Documentation=https://github.com/TheTechNetwork/Fleetwright
After=network-online.target fleetwright.service
Wants=network-online.target
# Not Requires=: the sidecar deliberately stays up when fleetwright is down, and
# reports "hub unreachable" rather than disappearing from the fleet. A host that
# can tell you it is broken is worth more than one that is silently absent.
After=fleetwright.service

[Service]
Type=simple
# __USER__ / __DIR__ / __NODE__ / __ENTRY__ are substituted by install.sh.
#
# __ENTRY__ IS WHAT NODE RUNS, and it is computed rather than written here
# because the answer differs between the two shapes an install can take. A
# checkout's bin/<name> is JavaScript; a release ships lib/<name>.mjs plus a
# thin bin/ shim. This used to say __DIR__/bin/<name> for both, so on a release
# systemd ran `node <shim>` — and when that shim was a shell script, every
# service died at startup with a syntax error. Naming the module removes the
# shim from the path systemd takes at all.
# ITS OWN ACCOUNT, not the one fleetwright and the sessions run as. install.sh
# creates `fleetwright-sidecar` (FLEETWRIGHT_SIDECAR_USER to choose another) and
# substitutes it here. The sidecar holds this box's private key and the
# coordinator socket; fleetwright's user holds every member's Claude and
# provider credential and the podman image store. One uid holding both meant a
# compromised sidecar could read ~/.claude and connections/*.env, and a session
# escape landing as the service user could read the host key — #270. Two uids,
# and each can only read its own half. Everything the sidecar used to read out
# of fleetwright's state directory it now asks fleetwright for over the loopback.
User=__SIDECAR_USER__
WorkingDirectory=__DIR__
EnvironmentFile=/etc/fleetwright-sidecar.env
ExecStart=__NODE__ __ENTRY__

Restart=always
RestartSec=3

# NO RuntimeDirectory. It used to make /run/fleetwright-sidecar for the
# per-session hook sockets, from a design in which the sidecar served them. It
# never did — fleetwright opens each one before `podman run`, and its own unit
# has RuntimeDirectory=fleetwright for them — and a 0700 directory owned by this
# account is exactly one fleetwright's account cannot enter.

# This box's private key lives here — /var/lib/fleetwright-sidecar, created 0700 owned
# by this user before the service starts. It is the whole of this host's
# identity in the fleet: whoever can read it can be this machine, and nothing
# else can. Deliberately NOT under /etc with the env file, because the env file
# is a config file people copy between boxes and this must never be copied.
StateDirectory=fleetwright-sidecar
StateDirectoryMode=0700

# It holds no session state and stopping it must never disturb a session — the
# same reasoning as fleetwright's own shutdown.
KillMode=control-group
TimeoutStopSec=10


# --- Hardening ---------------------------------------------------------------
#
# MUCH HARDER THAN fleetwright.service, and that is not an inconsistency — it is
# the difference between the two processes. This one spawns nothing: it is a
# single Node process that talks WebSocket to the coordinator and HTTP to
# 127.0.0.1:8790, and every directive rejected next door was rejected because
# of podman or tmux, neither of which exists here.
#
# Measured the same way — `systemd-run` with the whole set, running a probe that
# does what this actually does: write and chmod a 0600 file in the state
# directory, sign with ed25519, listen on loopback, and make an HTTP request.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
UMask=0077
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
# EPERM RATHER THAN SIGSYS, and this line is why the filter is usable at all.
# Measured: with the default action, `@system-service` kills Node outright —
# status=31/SYS, before it prints anything. Node makes a call outside that set
# and tolerates being refused, but not being shot. The syscall is denied either
# way; this chooses which of "denied" and "dead" the process gets.
SystemCallErrorNumber=EPERM
#
# ProtectHome=yes: there is nothing under anybody's home this process needs.
# It used to be read-only, for the account and connection files under the
# hub's state directory, which it read directly and now asks fleetwright for.
# install.sh drops it back to read-only on the one box where the code or the
# node it runs on lives under /home or /root, and says so.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fleetwright-sidecar

[Install]
WantedBy=multi-user.target
