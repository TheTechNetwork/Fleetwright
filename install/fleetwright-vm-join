#!/bin/bash
# fleetwright-vm-join JOIN_FILE
#
# Run once, as root, by cloud-init on a machine cloned from a Fleetwright
# machine image (src/fleet/host/vm-image.js). JOIN_FILE is the one file the
# box that made the machine put on its cloud-init drive
# (src/fleet/host/xo-pools.js, machineCloudConfig): the coordinator, a
# single-use ticket, whose machine this is, and how many minutes it lives.
# Not their Claude login: the sidecar asks for that once the machine has
# enrolled, and the box that made it hands it over (docs/security.md, G14).
# A file from a box older than that still carries it, and it is used.
#
# WHAT IT DOES, in this order, and why the order:
#
#   1. Wipes the cloud-init drive. It holds the ticket, which every box
#      holding the pool's token may read through Xen Orchestra until the
#      drive is destroyed, by default five minutes after boot (5.211.0); this does not
#      wait, and the sidecar spends the ticket only after this step.
#   2. Moves the file beside the sidecar's key, readable by the sidecar only,
#      and names it in the sidecar's environment. The sidecar enrols itself
#      with the ticket on its first start, asks for its owner's Claude login
#      and hands it to the hub (src/fleet/host/vm-join.js, sidecar.js), then
#      deletes the file.
#   3. Applies what the machine may do from chat, when its owner chose on the
#      pool's policy (`grants` in the file, src/core/grants.js): the same
#      `fleetwright grant` a person runs on a box, once per answer, before
#      anything starts. Left out, the machine keeps the image's answer.
#   4. Starts the services, which the image left off so that no machine ever
#      dials the fleet before it has a name of its own.
#   5. Powers the machine off at its end. The box that made it removes it
#      once it is off (xo-pools.js, sweep), so the end needs nobody.
#
# A POOL'S OWN MACHINE (src/fleet/host/xo-holder.js) is booted with a pin and
# the name it is bound to instead of a ticket, and the Xen Orchestra it holds.
# It has no end: step 5 is skipped, and the address it holds goes in the
# sidecar's environment, so its health says it is that pool's own machine.
set -euo pipefail

JOIN="${1:?usage: fleetwright-vm-join JOIN_FILE}"
STATE=/var/lib/fleetwright-sidecar
ENV_FILE=/etc/fleetwright-sidecar.env
UNIT=/etc/systemd/system/fleetwright-sidecar.service

say() { printf 'fleetwright-vm-join: %s\n' "$*"; }

[ -f "$JOIN" ] || { say "no join file at $JOIN"; exit 1; }

# One field of the join file. python3 is on every Debian cloud image, because
# cloud-init is written in it.
field() {
  python3 -I -c 'import json, sys
v = json.load(open(sys.argv[1])).get(sys.argv[2])
print("" if v is None else v)' "$JOIN" "$1"
}

COORDINATOR="$(field coordinator)"
HOLDER="$(field holder)"
case "$HOLDER" in *[!A-Za-z0-9.:\[\]-]*) say "the join file names a pool this cannot be"; exit 1 ;; esac
MINUTES="$(field minutes)"
case "$MINUTES" in '' | *[!0-9]*) MINUTES=60 ;; esac
case "$COORDINATOR" in https://*) ;; *) say "the join file names no https coordinator"; exit 1 ;; esac

# --- 1. the drive ------------------------------------------------------------
DRIVE="$(blkid -L cidata 2>/dev/null || blkid -L CIDATA 2>/dev/null || true)"
if [ -n "$DRIVE" ] && [ -b "$DRIVE" ]; then
  dd if=/dev/zero of="$DRIVE" bs=1M count=8 conv=fsync status=none 2>/dev/null || true
  say "wiped the cloud-init drive"
fi

# --- 2. the file, for the sidecar ---------------------------------------------
SIDECAR_USER="$(sed -n 's/^User=[[:space:]]*//p' "$UNIT" 2>/dev/null | head -1)"
SIDECAR_USER="${SIDECAR_USER:-fleetwright-sidecar}"
install -d -m 0700 -o "$SIDECAR_USER" "$STATE"
install -m 0600 -o "$SIDECAR_USER" "$JOIN" "$STATE/vm-join.json"
rm -f "$JOIN"

# Replace a line or add it, leaving everything else in the file as it was.
set_env() {
  local key="$1" value="$2"
  touch "$ENV_FILE"
  if grep -q "^${key}=" "$ENV_FILE"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$value" >>"$ENV_FILE"
  fi
}
set_env FLEETWRIGHT_COORDINATOR_URL "$COORDINATOR"
set_env FLEETWRIGHT_VM_JOIN "$STATE/vm-join.json"
[ -z "$HOLDER" ] || set_env FLEETWRIGHT_HOLDER_FOR "$HOLDER"

# --- 3. what it may do from chat ---------------------------------------------
# "on" or "off" for a grant its owner answered, and nothing for one they did
# not: only a real yes or no in the file is ever applied.
grant_answer() {
  python3 -I -c 'import json, sys
g = json.load(open(sys.argv[1])).get("grants")
v = g.get(sys.argv[2]) if isinstance(g, dict) else None
print({True: "on", False: "off"}.get(v, "") if isinstance(v, bool) else "")' "$STATE/vm-join.json" "$1"
}
FLEETWRIGHT_CLI="$(command -v fleetwright || echo /usr/local/bin/fleetwright)"
for grant in upgrades reboot; do
  to="$(grant_answer "$grant")"
  [ -n "$to" ] || continue
  # A grant that does not take is said and the machine still joins: it is
  # then a machine that asks for less, and its page says which.
  if "$FLEETWRIGHT_CLI" grant "$grant" "$to"; then
    say "$grant from chat is $to, as its owner chose for the pool's machines"
  else
    say "could not turn $grant from chat $to; on this machine: sudo fleetwright grant $grant $to"
  fi
done

# --- 4. the services ----------------------------------------------------------
systemctl enable --now fleetwright.service fleetwright-sidecar.service
if [ -n "$HOLDER" ]; then
  say "started; this machine joins $COORDINATOR as the machine of its own that holds $HOLDER"
  say "it has no end, and holds the pool once its owner approves it on the phone"
  exit 0
fi
say "started; this machine joins $COORDINATOR as its owner's temporary host"

# --- 5. its end ---------------------------------------------------------------
shutdown -P "+$MINUTES" "This temporary machine has reached the end it was made for."
say "powers off in $MINUTES minutes"
