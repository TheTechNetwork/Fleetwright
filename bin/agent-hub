#!/usr/bin/env node
// agent-hub CLI.
//
// Everything except `serve` talks to the RUNNING hub over its loopback HTTP
// port rather than touching the state file directly. Two writers to one JSON
// file is a corruption bug waiting for a busy afternoon, and the hub is always
// listening (config.js guarantees the HTTP adapter starts even in a
// Telegram-only deployment).
//
//   agent-hub serve            run the service (what systemd starts)
//   agent-hub doctor           check this box can actually run sessions
//   agent-hub doctor --repair  and fix what can be fixed safely
//   agent-hub hook             SessionStart hook — reads Claude's JSON on stdin
//   agent-hub <command...>     any chat command, e.g. `agent-hub list`

import { spawnSync } from 'node:child_process';
import { loadConfig } from '../src/config.js';
import { loadEnvFile } from '../src/core/env-file.js';
import { Registry } from '../src/core/registry.js';
import { titleFromTranscript } from '../src/core/titles.js';
import { existsSync } from 'node:fs';
import { readApiToken, apiTokenFile } from '../src/core/api-token.js';
import { updateStatus } from '../src/core/update.js';
import { releaseLayout } from '../src/core/release-apply.js';
import { checkRelease } from '../src/core/release-check.js';
import { accessSync, constants as fsConstants, mkdirSync } from 'node:fs';

const argv = process.argv.slice(2);
const sub = argv[0] || 'serve';

// Before loadConfig, so the CLI sees exactly what the service sees.
loadEnvFile(process.env.AGENT_HUB_ENV_FILE || '/etc/agent-hub.env');
const cfg = loadConfig();
const base = `http://${cfg.bind === '0.0.0.0' || cfg.bind === '::' ? '127.0.0.1' : cfg.bind}:${cfg.port}`;

switch (sub) {
  case 'serve':
    await (await import('../src/index.js')).main();
    break;
  case 'hook':
    await runHook();
    break;
  case 'doctor':
    await doctor({ repair: argv.includes('--repair') });
    break;
  case 'help':
  case '--help':
  case '-h':
    usage();
    break;
  default:
    await command(argv.join(' '));
}

function usage() {
  console.log(`agent-hub — portable Claude Code session manager

  agent-hub serve              run the service (systemd calls this)
  agent-hub doctor             check this box can run sessions
  agent-hub doctor --repair    and fix what can be fixed safely
  agent-hub hook               SessionStart hook (reads Claude's JSON on stdin)
  agent-hub <command...>       run a command against the running hub, e.g.

      agent-hub list
      agent-hub new mysession
      agent-hub resume mysession
      agent-hub stop mysession
      agent-hub login
      agent-hub status

Config comes from the environment — see install/agent-hub.env.example.`);
}

/**
 * Send a command line to the running hub and print its reply.
 *
 * The timeout is generous because several commands legitimately take a while:
 * starting a session waits out the Remote Control check (up to ~2x10s),
 * `login` waits up to 45s for the authorization URL to appear, and a resume
 * waits for the dialog. A short timeout here reports "could not reach
 * agent-hub" for a hub that is working perfectly.
 */
async function command(line) {
  const res = await post('/api/command', { command: line }, 300_000).catch((e) => {
    console.error(
      `Could not reach agent-hub at ${base} (${e.message}).\n` +
        'Is the service running?  systemctl status agent-hub',
    );
    process.exit(1);
  });
  console.log(res.text);
  process.exit(res.ok === false ? 1 : 0);
}

/**
 * Claude Code SessionStart hook.
 *
 * Claude pipes us a JSON object containing its own session_id and transcript
 * path, so the conversation uuid we record is authoritative — far better than
 * scraping a command line, which is what the predecessor of this tool did and
 * why it sometimes resumed the wrong conversation.
 *
 * Always exits 0. A hook that fails must never block a session from starting.
 */
async function runHook() {
  try {
    // Only tmux sessions are managed here; a headless `claude -p` run is not
    // something anyone resumes.
    if (!process.env.TMUX) process.exit(0);

    const name = tmuxSessionName();
    if (!name) process.exit(0);

    const raw = await readStdin();
    const payload = safeParse(raw);

    // The transcript filename IS the conversation uuid, which makes it the
    // most reliable source; session_id is the fallback.
    const fromPath = String(payload.transcript_path || '').match(/([0-9a-f]{8}-[0-9a-f-]{27})\.jsonl$/);
    const uuid = fromPath ? fromPath[1] : String(payload.session_id || '');
    if (!/^[0-9a-f]{8}-[0-9a-f-]{27}$/.test(uuid)) process.exit(0);

    const cwd = String(payload.cwd || process.cwd());
    // What the person actually asked for, read out of Claude's own transcript.
    // Best effort: a session that has not been spoken to yet has none, and the
    // hub falls back to the working directory.
    const title = titleFromTranscript(payload.transcript_path);

    try {
      await post('/internal/session-start', { name, cwd, uuid, ...(title ? { title } : {}) }, 3000);
    } catch {
      // The hub is restarting, moved port, or not up yet. Spool it; the hub
      // drains this on its next reconcile. A dropped uuid means an
      // unresumable session, which is the one outcome worth this fallback.
      Registry.appendSpool(cfg, { name, cwd, uuid });
    }
  } catch {
    /* never block a session */
  }
  process.exit(0);
}

async function doctor({ repair = false } = {}) {
  let bad = 0;
  /** @type {Array<{ what: string, run: () => boolean, needsRoot?: boolean }>} */
  const repairs = [];
  const ok = (label, good, detail = '') => {
    if (!good) bad++;
    console.log(`${good ? ' ok ' : 'FAIL'}  ${label}${detail ? `  — ${detail}` : ''}`);
  };

  const tmuxV = spawnSync('tmux', ['-V'], { encoding: 'utf8' });
  ok('tmux installed', tmuxV.status === 0, (tmuxV.stdout || '').trim() || 'apt install tmux');

  const claudeV = spawnSync(cfg.claudeBin, ['--version'], { encoding: 'utf8' });
  ok(`claude on PATH (${cfg.claudeBin})`, claudeV.status === 0, (claudeV.stdout || '').trim());

  const auth = spawnSync(cfg.claudeBin, ['auth', 'status', '--json'], { encoding: 'utf8' });
  let authOk = false;
  let authDetail = 'run: agent-hub login';
  try {
    const parsed = JSON.parse(auth.stdout || '{}');
    authOk = parsed.loggedIn === true;
    // `?` IS NOT AN ANSWER. This printed "logged in — ? (oauth_token)" when
    // the CLI reports a session with no email on it, which a beta tester
    // reasonably read as something being wrong. It is not: an account can be
    // signed in and simply not expose an address here.
    //
    // Say which fact is missing rather than punctuating at somebody.
    if (authOk) {
      const who = parsed.email || 'an account that does not report an address';
      const how = parsed.subscriptionType || parsed.authMethod || 'method not reported';
      authDetail = `${who} (${how})`;
    }
  } catch { /* leave as not-logged-in */ }
  ok('claude logged in', authOk, authDetail);

  ok(`workdir ${cfg.workdir}`, true);
  ok(`state dir ${cfg.stateDir}`, true);

  let hubUp = false;
  try {
    const r = await fetch(`${base}/healthz`, { signal: AbortSignal.timeout(3000) });
    hubUp = r.ok;
  } catch { /* down */ }
  // ONE FACT, ONCE. "hub unreachable" and "agent-hub.service is inactive" are
  // the same news, and printing both is how a screen ends up contradicting
  // itself — the defect the `updates` verb exists to remove, one tool over. The
  // unit is the more useful of the two because it carries the remedy, so when
  // there is a unit it gets to be the one that speaks.
  const unit = unitState();
  if (!unit.known || hubUp) {
    ok(`hub reachable at ${base}`, hubUp, hubUp ? '' : 'is it running? there is no systemd unit here');
  }

  ok('a control surface is configured', cfg.webEnabled, 'web, app, MCP and CLI');

  // --- the install itself ---------------------------------------------------
  //
  // EVERY CHECK BELOW IS A STATE A REAL BOX REACHED, and none of them was
  // visible from here. doctor asked whether this box could run a SESSION; the
  // afternoons lost were all to whether it could run ITSELF.
  const status = updateStatus(cfg);
  const layout = releaseLayout(cfg.installDir);
  // THE LAYOUT DECIDES WHETHER THIS IS A RELEASE BOX, NOT THE PAYLOAD.
  //
  // `updateStatus` answers `packaged: true` only when lib/agent-hub.mjs is
  // there — reasonable for its own question, and exactly backwards here: on a
  // partial release it answers neither-checkout-nor-release, so gating on it
  // skipped every check below on the one box that most needed them. doctor
  // would have printed seven cheerful lines about tmux and said nothing at all
  // about the reason the service was in a restart loop.
  if (status.packaged || layout.ok) {
    ok('the release layout is intact', layout.ok, layout.ok ? cfg.installDir : layout.message);

    // AND THE PAYLOAD IS ACTUALLY THERE, which the layout check does not ask.
    // releaseLayout validates the SHAPE of the path — that this is
    // <base>/current or <base>/releases/<version> — and a directory with no
    // lib/ in it passes that perfectly.
    //
    // It is the nastier of the two broken states, because every cheap check
    // agrees: the symlink resolves, the directory exists, `current` looks
    // right. Only opening the file the unit is supposed to run says otherwise,
    // and nothing did — so a box sat in a restart loop with a layout check
    // reporting `ok`.
    const entry = `${cfg.installDir}/lib/agent-hub.mjs`;
    ok(
      'the release has something to run',
      existsSync(entry),
      existsSync(entry) ? '' : `${entry} is missing — re-run the installer, which will re-lay this release`,
    );

    // THE ONE THAT ONLY SHOWS UP WHEN YOU TRY TO UPDATE, and then as an EACCES
    // from deep inside an unpack. Converting a box creates the release tree as
    // root, and the service user could not write it — so the box could not
    // apply its own updates and had no way to find that out until it failed.
    if (layout.ok) {
      const writable = canWrite(layout.base) && canWrite(`${layout.base}/releases`);
      ok(
        'updates can be applied without root',
        writable,
        writable ? '' : `${layout.base} is not writable by ${whoami()} — re-run the installer`,
      );
      if (!writable) repairs.push({
        what: `make ${layout.base} writable by ${whoami()}`,
        // NOT ATTEMPTED WITHOUT ROOT, and named rather than tried-and-failed: a
        // chown that fails prints a permission error about fixing a permission
        // error, which reads as the tool being broken.
        run: () => chownTree(layout.base),
        needsRoot: true,
      });
    }
  }

  // --- the service -----------------------------------------------------------
  if (unit.known) {
    ok(`agent-hub.service is ${unit.state}`, unit.state === 'active', unit.detail);
    if (unit.state !== 'active') {
      repairs.push({
        // RESET-FAILED FIRST. systemd stops trying after StartLimitBurst and
        // then answers "Start request repeated too quickly" to every start —
        // so a plain restart on a box in that state does nothing and says
        // almost nothing, which is how a counter reached 6423.
        what: 'clear the failure counter and start agent-hub',
        run: () => systemctl(['reset-failed', 'agent-hub']) && systemctl(['start', 'agent-hub']),
        needsRoot: true,
      });
    }
  }

  // --- what is waiting -------------------------------------------------------
  //
  // OFFERED, NEVER APPLIED, INCLUDING UNDER --repair. Updating is the one thing
  // here that changes what this box RUNS, and a tool called "doctor --repair"
  // silently moving a machine onto new code is a surprise nobody asked for. It
  // is also the one remedy that is genuinely a decision: a box mid-session has
  // a reason to wait.
  if (cfg.releaseManifest) {
    const rel = await checkRelease(cfg);
    if (rel.available) {
      console.log(`note  an update is waiting: ${rel.available}`);
      console.log('      to take it:  agent-hub update');
      console.log('      not applied by --repair, on purpose — this changes what the box runs');
    } else if (rel.configured === false) {
      ok('this box knows where its releases come from', false, rel.message);
    }
  }

  if (repairs.length && !repair) {
    console.log('');
    console.log(`${repairs.length} of these can be fixed for you:  agent-hub doctor --repair`);
    for (const r of repairs) console.log(`      - ${r.what}`);
  }

  if (repair) {
    console.log('');
    for (const r of repairs) {
      if (r.needsRoot && process.getuid?.() !== 0) {
        console.log(`skip  ${r.what} — needs root: sudo agent-hub doctor --repair`);
        continue;
      }
      let done = false;
      try {
        done = r.run() !== false;
      } catch (e) {
        done = false;
        console.log(`FAIL  ${r.what} — ${e.message}`);
        continue;
      }
      console.log(`${done ? ' ok ' : 'FAIL'}  ${r.what}`);
      // A REPAIR THAT DID NOT WORK IS STILL A FAILURE. Reporting the attempt
      // and exiting 0 is how "doctor says it fixed it" and "the box is still
      // broken" end up in the same sentence.
      if (!done) bad++;
    }
    if (!repairs.length) console.log('nothing to repair');
  }

  process.exit(bad ? 1 : 0);
}

/** Can this process write here? Asked of the directory, not guessed from uid. */
function canWrite(dir) {
  try {
    accessSync(dir, fsConstants.W_OK);
    return true;
  } catch {
    return false;
  }
}

function whoami() {
  try {
    return process.env.USER || String(process.getuid?.());
  } catch {
    return 'this user';
  }
}

function chownTree(dir) {
  const who = cfg.runUser || process.env.SUDO_USER || '';
  if (!who) return false;
  return spawnSync('chown', ['-R', who, dir]).status === 0;
}

function systemctl(args) {
  return spawnSync(cfg.systemctlBin, args).status === 0;
}

/**
 * What systemd thinks of agent-hub.service.
 *
 * `known: false` on a box with no unit — a checkout somebody runs by hand is
 * not broken, and reporting it as a failed service would be the reassuring kind
 * of wrong in reverse.
 */
function unitState() {
  if (!existsSync('/etc/systemd/system/agent-hub.service')) return { known: false };
  const r = spawnSync(cfg.systemctlBin, ['is-active', 'agent-hub'], { encoding: 'utf8' });
  const state = (r.stdout || '').trim() || 'unknown';
  let detail = '';
  if (state !== 'active') {
    const j = spawnSync(cfg.systemctlBin, ['is-failed', 'agent-hub'], { encoding: 'utf8' });
    detail = (j.stdout || '').trim() === 'failed' ? 'failed — journalctl -u agent-hub' : '';
  }
  return { known: true, state, detail };
}

// --- helpers ---------------------------------------------------------------

function tmuxSessionName() {
  const args = ['display-message', '-p', '#{session_name}'];
  if (process.env.TMUX_PANE) args.splice(1, 0, '-t', process.env.TMUX_PANE);
  const r = spawnSync('tmux', args, { encoding: 'utf8' });
  return r.status === 0 ? (r.stdout || '').trim() : '';
}

/**
 * The token this CLI presents, which is usually not in anybody's shell.
 *
 * agent-hub's API used to be open whenever AGENT_HUB_TOKEN was unset, and this
 * CLI was written against that: send a header if the environment happens to
 * have one, otherwise send nothing and be let in. Closing that hole gave the
 * service a generated token — and made THIS the third client, which nobody
 * updated. The sidecar got a fallback the same hour; the CLI did not, so
 * `agent-hub update` on a freshly updated box answers "unauthorised" and asks
 * about a variable that is not the answer.
 *
 * Third clients are how this keeps happening: two were in mind and the one
 * driven by a person at a keyboard was not.
 *
 * NOT MEMOISED IN A MODULE-LEVEL `let`, which is how the first version of this
 * failed: this script runs its work above the point that declaration would sit
 * at, so the first call hit the temporal dead zone and reported "Cannot access
 * 'resolvedToken' before initialization" — a worse error than the one it was
 * fixing. One small file read per invocation costs nothing.
 *
 * An explicit AGENT_HUB_TOKEN still wins: somebody who set one has their own
 * arrangement.
 */
function apiToken() {
  return cfg.token || readApiToken(cfg.stateDir) || '';
}

async function post(path, body, timeoutMs = 15_000) {
  /** @type {Record<string,string>} */
  const headers = { 'content-type': 'application/json' };
  const token = apiToken();
  if (token) headers.authorization = `Bearer ${token}`;
  const res = await fetch(`${base}${path}`, {
    method: 'POST',
    headers,
    body: JSON.stringify(body),
    signal: AbortSignal.timeout(timeoutMs),
  });
  if (!res.ok && res.status === 401) throw new Error(unauthorisedHelp());
  return res.json();
}

function readStdin() {
  return new Promise((resolve) => {
    let data = '';
    // If nothing is piped in, do not hang the session waiting for EOF.
    const timer = setTimeout(() => resolve(data), 2000);
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (c) => (data += c));
    process.stdin.on('end', () => {
      clearTimeout(timer);
      resolve(data);
    });
    process.stdin.on('error', () => {
      clearTimeout(timer);
      resolve(data);
    });
  });
}

function safeParse(s) {
  try {
    return JSON.parse(s || '{}');
  } catch {
    return {};
  }
}

/**
 * Why this call was refused, in terms of what to do about it.
 *
 * The old text asked whether AGENT_HUB_TOKEN was set in the shell, which is
 * the wrong question on almost every box: the service generates its own and
 * nobody is expected to export anything. The interesting case is a PERMISSION
 * one — the token file is 0600 and owned by the service user, so running the
 * CLI as somebody else reads nothing and gets a 401 that looks like a bug.
 */
function unauthorisedHelp() {
  const file = apiTokenFile(cfg.stateDir);
  if (apiToken()) {
    return `unauthorised — the token in ${file} is not the one the service is using. Restart it: systemctl restart agent-hub`;
  }
  if (existsSync(file)) {
    return (
      `unauthorised — ${file} exists but this user cannot read it (it is 0600 and owned by the service user).\n`
      + `Run as that user, or with sudo: sudo -u ${cfg.runUser || 'agent'} agent-hub …`
    );
  }
  return (
    `unauthorised — no API token found at ${file}, and AGENT_HUB_TOKEN is not set in this shell.\n`
    + 'A running service generates that file on startup, so this usually means it has not started since the '
    + 'last update: systemctl status agent-hub'
  );
}
