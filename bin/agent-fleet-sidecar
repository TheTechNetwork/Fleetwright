#!/usr/bin/env node
// The sidecar entrypoint.
//
//   agent-fleet-sidecar            run it (systemd calls this)
//   agent-fleet-sidecar enrol 123456   present this box to a coordinator, once
//   agent-fleet-sidecar identity   show this box's key fingerprint
//   agent-fleet-sidecar doctor     check this box can actually drive its agent-hub
//
// Config comes from the environment — see src/fleet/host/config.js. This process
// does not touch the session manager's state directly: it is an HTTP client of it.

import { loadSidecarConfig, validateSidecarConfig } from '../src/fleet/host/config.js';
import { HubClient } from '../src/fleet/host/hub-client.js';
import { loadConfig } from '../src/config.js';
import { updateAvailable } from '../src/core/update.js';
import { systemUpdates, describeSystemUpdates, refreshPackageLists } from '../src/core/upgrades.js';
import { Sidecar } from '../src/fleet/host/sidecar.js';
import { HookSocketServer } from '../src/core/hook-socket.js';
import { loadOrCreateKey, enrol, proveIdentity, checkEnrolled, keyFingerprint } from '../src/fleet/host/identity.js';
import { StdioTransport } from '../src/fleet/host/transports/stdio.js';
import { WebSocketTransport } from '../src/fleet/host/transports/websocket.js';
import { log, setLogLevel, setLogStream } from '../src/log.js';

const cfg = loadSidecarConfig();
setLogLevel(cfg.logLevel);
// stdout is the stdio transport's data channel, so every log line goes to
// stderr — an info line landing on stdout is a corrupted message, not noise.
setLogStream(process.stderr);

const sub = process.argv[2] || 'run';
if (sub === 'doctor') await doctor();
else if (sub === 'enrol' || sub === 'enroll') await doEnrol(process.argv[3]);
else if (sub === 'identity') await identity();
else if (sub === 'help' || sub === '--help' || sub === '-h') usage();
else await run();

function usage() {
  console.log(`agent-fleet-sidecar — drives a stock agent-hub on behalf of the fleet coordinator

  agent-fleet-sidecar            run
  agent-fleet-sidecar enrol PIN  present this box to the coordinator (six-digit pin from /enroll)
  agent-fleet-sidecar identity   print this box's key fingerprint
  agent-fleet-sidecar doctor     check this box can drive its agent-hub

Environment:
  AGENT_FLEET_COORDINATOR_URL    required — the origin this sidecar pins
  AGENT_FLEET_HUB_URL            default http://127.0.0.1:8790
  AGENT_FLEET_HUB_TOKEN          agent-hub's AGENT_HUB_TOKEN, if it has one
  AGENT_FLEET_HOST_ID            default: this hostname
  AGENT_FLEET_LABELS             comma-separated scheduler constraints
  AGENT_FLEET_TRANSPORT          websocket (default) or stdio
  AGENT_FLEET_HOST_KEY           this host's private key file (default /var/lib/agent-fleet/host-key.json)
  AGENT_FLEET_HOOK_SOCKETS       1 to serve per-session hook sockets, 0 to skip`);
}

async function run() {
  const { errors, warnings } = validateSidecarConfig(cfg);
  for (const w of warnings) log.warn(`config: ${w}`);
  if (errors.length) {
    for (const e of errors) log.error(`config: ${e}`);
    process.exit(1);
  }

  const hub = new HubClient({
    baseUrl: cfg.hubUrl,
    token: cfg.hubToken,
    commandTimeoutMs: cfg.hubCommandTimeoutMs,
    readTimeoutMs: cfg.hubReadTimeoutMs,
  });

  // Not fatal. agent-hub may be starting alongside this, and the sidecar's job
  // is to keep answering the coordinator either way — a host that reports
  // "hub unreachable" is far more useful than one that exited.
  if (!(await hub.alive())) {
    log.warn(`agent-hub at ${cfg.hubUrl} is not answering yet — carrying on, health will report it`);
  }

  // The key is loaded once and stays in this process's memory. If the file is
  // missing we make one — a box that has never enrolled still needs a key to
  // enrol with, and generating it here means `enrol` and `run` cannot disagree
  // about which key this host has.
  let key = null;
  if (cfg.transport === 'websocket') {
    try {
      key = await loadOrCreateKey(cfg.hostKeyFile);
      log.info(`host identity ${await keyFingerprint(key.publicJwk)}`);
      if (key.created) {
        log.warn('this box has no identity at the coordinator yet — run: agent-fleet-sidecar enrol <pin>');
      }
    } catch (e) {
      log.error(`host key: ${/** @type {Error} */ (e).message}`);
      process.exit(1);
    }
  }

  const transport =
    cfg.transport === 'websocket'
      ? new WebSocketTransport({
          origin: cfg.coordinatorUrl,
          hostId: cfg.hostId,
          proof: () =>
            proveIdentity({ origin: cfg.coordinatorUrl, hostId: cfg.hostId, privateJwk: key.privateJwk }),
          logger: log,
        })
      : new StdioTransport({ origin: cfg.coordinatorUrl });
  const sidecar = new Sidecar({
    hub,
    transport,
    hostId: cfg.hostId,
    labels: cfg.labels,
    maxSkewMs: cfg.maxSkewMs,
    logger: log,
    // Reported with health, so a phone can say "this box is 3 commits behind
    // and has 12 packages waiting" without anybody logging in to look.
    updates: () => {
      const hub = loadConfig();
      const app = updateAvailable(hub);
      // Refresh first, at most every six hours and only if permitted. A box
      // that never refreshes its own lists answers "no updates" indefinitely,
      // which is the reassuring kind of wrong.
      refreshPackageLists(hub);
      const system = systemUpdates();
      return {
        appBehind: app.ok ? app.behind : null,
        system: describeSystemUpdates(system),
        rebootRequired: system.rebootRequired,
      };
    },
  });

  // The per-session hook sockets. The sidecar owns them, so it knows which
  // session a report came from and forwards it to agent-hub's loopback hook
  // endpoint with that name attached — which is how a container gets a
  // conversation uuid recorded without ever being able to name a session, and
  // without agent-hub changing at all.
  const hooks = cfg.hookSocketsEnabled
    ? new HookSocketServer({
        dir: cfg.hookSocketDir,
        onSessionStart: (r) => hub.recordSessionStart(r),
        logger: log,
      })
    : null;

  await sidecar.start();

  const shutdown = async (/** @type {string} */ signal) => {
    // Deliberately does NOT stop anything on the hub. The sessions are the
    // work; the sidecar is a remote control for them, and it restarting must
    // not disturb them — the same reasoning as agent-hub's own shutdown.
    log.info(`${signal} — shutting down (agent-hub and its sessions are left alone)`);
    try {
      await sidecar.stop();
      await hooks?.closeAll();
    } catch { /* best effort */ }
    process.exit(0);
  };
  process.on('SIGTERM', () => void shutdown('SIGTERM'));
  process.on('SIGINT', () => void shutdown('SIGINT'));
  process.on('unhandledRejection', (e) => log.error('unhandled rejection', e));

  // stdio mode ends when its input does. The websocket transport never ends on
  // its own — that is the point of it — so the process stays up until signalled.
  if (transport instanceof StdioTransport) {
    await transport.closed;
    await hooks?.closeAll();
  }
}

/**
 * Spend a six-digit pin to register this box's public key.
 *
 * Deliberately separate from `run`: enrolling is a thing an operator does once,
 * with a code that lives ten minutes, and a service that could enrol itself on
 * restart would be a service that could be tricked into re-enrolling elsewhere.
 *
 * @param {string|undefined} pin
 */
async function doEnrol(pin) {
  if (!pin) {
    console.error('usage: agent-fleet-sidecar enrol <six-digit pin>\n\nGet a pin with /enroll in Telegram or from the app.');
    process.exit(2);
  }
  if (!cfg.coordinatorUrl) {
    console.error('AGENT_FLEET_COORDINATOR_URL is not set — there is nothing to enrol with.');
    process.exit(2);
  }
  try {
    const key = await loadOrCreateKey(cfg.hostKeyFile);
    const fp = await keyFingerprint(key.publicJwk);
    const res = await enrol({
      origin: cfg.coordinatorUrl,
      code: pin,
      hostId: cfg.hostId,
      publicJwk: key.publicJwk,
    });
    console.log(`enrolled ${cfg.hostId} at ${cfg.coordinatorUrl}`);
    console.log(`  fingerprint ${fp}`);
    if (res.replaced) console.log('  (replaced the key this host had registered before)');
    console.log('\nStart the sidecar:  sudo systemctl restart agent-fleet-sidecar');
  } catch (e) {
    console.error(`enrolment failed: ${/** @type {Error} */ (e).message}`);
    process.exit(1);
  }
}

async function identity() {
  const key = await loadOrCreateKey(cfg.hostKeyFile);
  console.log(`host id      ${cfg.hostId}`);
  console.log(`key file     ${cfg.hostKeyFile}`);
  console.log(`fingerprint  ${await keyFingerprint(key.publicJwk)}`);
  console.log(`coordinator  ${cfg.coordinatorUrl || '(unset)'}`);
}

async function doctor() {
  let bad = 0;
  /** @param {string} label @param {boolean} good @param {string} [detail] */
  const ok = (label, good, detail = '') => {
    if (!good) bad++;
    console.log(`${good ? ' ok ' : 'FAIL'}  ${label}${detail ? `  — ${detail}` : ''}`);
  };

  const { errors, warnings } = validateSidecarConfig(cfg);
  ok('configuration', errors.length === 0, errors.join('; '));
  for (const w of warnings) console.log(`warn  ${w}`);

  const hub = new HubClient({ baseUrl: cfg.hubUrl, token: cfg.hubToken, readTimeoutMs: cfg.hubReadTimeoutMs });
  const alive = await hub.alive();
  ok(`agent-hub reachable at ${cfg.hubUrl}`, alive, alive ? '' : 'systemctl status agent-hub');

  if (alive) {
    try {
      const state = await hub.state();
      ok('agent-hub accepts the token', true, `${state.running}/${state.maxSessions} running on ${state.host}`);
      ok('claude is logged in on the hub', state.auth?.loggedIn === true, state.auth?.summary || '');
    } catch (e) {
      ok('agent-hub accepts the token', false, /** @type {Error} */ (e).message);
    }
  }

  ok(`host id ${cfg.hostId}`, true, cfg.labels.length ? `labels: ${cfg.labels.join(', ')}` : 'no labels');

  if (cfg.transport === 'websocket') {
    try {
      const key = await loadOrCreateKey(cfg.hostKeyFile);
      ok(`host key ${cfg.hostKeyFile}`, true, `fingerprint ${await keyFingerprint(key.publicJwk)}`);
      // Enrolment is the coordinator's opinion, not ours — so ask it. A key that
      // exists locally but was never presented, or was revoked, looks identical
      // on disk and completely different on the wire.
      try {
        const known = await checkEnrolled({ origin: cfg.coordinatorUrl, hostId: cfg.hostId, privateJwk: key.privateJwk });
        ok('coordinator knows this host', known.ok, known.ok ? cfg.coordinatorUrl : `${known.reason} — agent-fleet-sidecar enrol <pin>`);
      } catch (e) {
        ok('coordinator knows this host', false, /** @type {Error} */ (e).message);
      }
    } catch (e) {
      ok('host key', false, /** @type {Error} */ (e).message);
    }
  }
  process.exit(bad ? 1 : 0);
}
