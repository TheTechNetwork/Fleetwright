#!/usr/bin/env node
// The fleet, as an MCP server on stdio.
//
//   fleetwright-mcp
//
// Configured entirely by environment, because that is what an MCP client hands
// a server it launches:
//
//   FLEETWRIGHT_COORDINATOR_URL   required — the fleet to talk to
//   FLEETWRIGHT_CREDENTIAL        required — a device token (fwk_…) from the app
//   FLEETWRIGHT_MCP_ALLOW         verbs to expose beyond the safe set, comma separated
//   FLEETWRIGHT_MCP_WATCH_SECONDS  how often to check started sessions and emit
//                                 a notification when one needs help or ends
//                                 (default 10; 0 turns it off). Best effort —
//                                 see the client matrix in docs/mcp.md.
//   FLEETWRIGHT_MCP_BUDGET_MINUTES  how long work here should take (default 15).
//                                 Stated to the agent rather than enforced: the
//                                 lifecycle is its to manage, and a number it
//                                 can act on beats a timer it cannot see.
//
// In Claude Desktop or Claude Code:
//
//   {
//     "mcpServers": {
//       "fleetwright": {
//         "command": "fleetwright-mcp",
//         "env": {
//           "FLEETWRIGHT_COORDINATOR_URL": "https://fleet.example",
//           "FLEETWRIGHT_CREDENTIAL": "fwk_…"
//         }
//       }
//     }
//   }
//
// STDOUT IS THE PROTOCOL. Every diagnostic goes to stderr — a stray line on
// stdout desynchronises the client, and the symptom is a server that "does not
// work" with nothing to read.

import { createInterface } from 'node:readline';
import { McpServer } from '../src/mcp/server.js';

const coordinator = process.env.FLEETWRIGHT_COORDINATOR_URL;
const credential = process.env.FLEETWRIGHT_CREDENTIAL;

if (!coordinator || !credential) {
  process.stderr.write(
    'fleetwright-mcp needs two things:\n' +
      '  FLEETWRIGHT_COORDINATOR_URL   the fleet to talk to\n' +
      '  FLEETWRIGHT_CREDENTIAL        a device token from the app (Settings — it is shown once)\n\n' +
      'It joins the fleet as that person: it can see and do exactly what they can, and nothing more.\n',
  );
  process.exit(2);
}

const server = new McpServer({
  coordinator,
  credential,
  budgetMinutes: Number(process.env.FLEETWRIGHT_MCP_BUDGET_MINUTES) || 15,
  watchMs:
    process.env.FLEETWRIGHT_MCP_WATCH_SECONDS === '0'
      ? 0
      : (Number(process.env.FLEETWRIGHT_MCP_WATCH_SECONDS) || 10) * 1000,
  allow: (process.env.FLEETWRIGHT_MCP_ALLOW || '')
    .split(/[,\s]+/)
    .map((s) => s.trim())
    .filter(Boolean),
  log: (m) => process.stderr.write(`${m}\n`),
});

const lines = createInterface({ input: process.stdin });
// Serialised. Handling two calls at once would interleave replies, and the
// client matches on id but the fleet does not need the concurrency.
let queue = Promise.resolve();
lines.on('line', (line) => {
  queue = queue.then(() => server.handleLine(line)).catch((e) => {
    process.stderr.write(`mcp: ${e.message}\n`);
  });
});
lines.on('close', () => process.exit(0));
